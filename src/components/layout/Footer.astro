---
import Logo from '../ui/Logo.astro';
import { SITE } from '../../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-hairline bg-canvas pt-16 pb-8">
  <div class="max-w-[72rem] mx-auto px-4 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8 mb-16">
      <div class="md:col-span-5">
        <Logo />
        <p class="mt-6 text-text-body max-w-[24rem]">
          {SITE.description}
        </p>
      </div>
      
      <div class="md:col-span-3">
        <h3 class="text-text-primary font-semibold mb-6 tracking-wide text-sm uppercase">Services</h3>
        <ul class="flex flex-col gap-4">
          <li><a href="/services/website-development" class="text-text-body hover:text-brand-hover transition-colors">Website Development</a></li>
          <li><a href="/services/seo" class="text-text-body hover:text-brand-hover transition-colors">Search Engine Optimization</a></li>
          <li><a href="/services/digital-marketing" class="text-text-body hover:text-brand-hover transition-colors">Digital Marketing</a></li>
          <li><a href="/services/social-media" class="text-text-body hover:text-brand-hover transition-colors">Social Media Management</a></li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <h3 class="text-text-primary font-semibold mb-6 tracking-wide text-sm uppercase">Contact</h3>
        <ul class="flex flex-col gap-4">
          <li>
            <a href="/contact" class="text-text-body hover:text-brand-hover transition-colors">Start a Project</a>
          </li>
          <li>
            <a href={`mailto:${SITE.email}`} class="text-text-body hover:text-brand-hover transition-colors">{SITE.email}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-hairline pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-text-disabled text-sm">
        &copy; {currentYear} SKYON IT Solutions. All rights reserved.
      </p>
      <div class="flex gap-6">
        <a href="/privacy" class="text-text-disabled text-sm hover:text-brand-hover transition-colors">Privacy Policy</a>
        <a href="/terms" class="text-text-disabled text-sm hover:text-brand-hover transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
