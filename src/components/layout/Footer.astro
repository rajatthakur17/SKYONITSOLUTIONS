---
import Logo from '../ui/Logo.astro';
import { SITE } from '../../config/site';
import { SERVICES } from '../../data/services';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer backdrop-12-footer border-t border-hairline pt-16 pb-8 relative z-20 isolate" style="isolation: isolate;">
  <div class="max-w-[72rem] mx-auto px-4 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8 mb-16">
      <div class="md:col-span-5">
        <Logo variant="footer" />
        <p class="mt-6 text-text-inverse-body max-w-[24rem]">
          {SITE.description}
        </p>
      </div>
      
      <div class="md:col-span-4">
        <h3 class="text-text-inverse font-semibold mb-6 tracking-wide text-sm uppercase">IT Services</h3>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2 text-sm">
          {SERVICES.map((service) => (
            <li><a href={`/services/${service.slug}`} class="text-text-inverse-body hover:text-accent-inverse transition-colors">{service.shortTitle}</a></li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-3">
        <h3 class="text-text-inverse font-semibold mb-6 tracking-wide text-sm uppercase">Explore &amp; Connect</h3>
        <ul class="flex flex-col gap-3 text-sm">
          <li><a href="/work" class="text-text-inverse-body hover:text-accent-inverse transition-colors">Work</a></li>
          <li><a href="/about" class="text-text-inverse-body hover:text-accent-inverse transition-colors">About</a></li>
          <li><a href="/why-choose-us" class="text-text-inverse-body hover:text-accent-inverse transition-colors">Why Choose Us</a></li>
          <li><a href="/insights" class="text-text-inverse-body hover:text-accent-inverse transition-colors">Insights</a></li>
          <li>
            <a href="/contact" class="text-text-inverse hover:text-accent-inverse transition-colors font-semibold">Start a Project &rarr;</a>
          </li>
          <li>
            <a href={SITE.whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-text-inverse-body hover:text-accent-inverse transition-colors flex items-center gap-2">
              <span class="text-whatsapp">WhatsApp:</span> {SITE.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${SITE.email}`} class="break-all text-text-inverse-body hover:text-accent-inverse transition-colors">
              {SITE.email}
            </a>
          </li>
          {SITE.linkedinUrl && (
            <li>
              <a href={SITE.linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-text-inverse-body hover:text-accent-inverse transition-colors">
                LinkedIn Profile &rarr;
              </a>
            </li>
          )}
          {SITE.instagramUrl && (
            <li>
              <a href={SITE.instagramUrl} target="_blank" rel="noopener noreferrer" class="text-text-inverse-body hover:text-accent-inverse transition-colors">
                Instagram Profile &rarr;
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>

    <div class="footer-bottom border-t pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-text-inverse-body text-sm">
        &copy; {currentYear} SKYON IT SOLUTIONS. ALL RIGHTS RESERVED.
      </p>
      <div class="flex gap-6">
        <a href="/privacy" class="text-text-inverse-body text-sm hover:text-accent-inverse transition-colors">Privacy Policy</a>
        <a href="/terms" class="text-text-inverse-body text-sm hover:text-accent-inverse transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-color: rgba(255, 255, 255, 0.2);
  }

  .footer-bottom {
    border-color: rgba(255, 255, 255, 0.2);
  }
</style>
