---
import Logo from '../ui/Logo.astro';
import { SITE } from '../../config/site';
import { SERVICES } from '../../data/services';
import FeedbackModal from '../ui/FeedbackModal.astro';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer backdrop-12-footer border-t border-hairline pt-12 pb-[126px] relative z-20 isolate" style="isolation: isolate;">
  <div class="max-w-[72rem] mx-auto px-4 md:px-8">
    <nav aria-label="Footer">
      <!-- ROW 1: Logo, Main Links, Social & Email Icons -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 md:gap-8">
        <div class="flex flex-col md:flex-row md:items-center gap-6 md:gap-8">
          <Logo variant="footer" class="h-9 [&>img]:!h-[36px] [&>img]:!w-auto flex-shrink-0" />

          <ul class="flex flex-wrap items-center gap-x-4 gap-y-2 md:gap-8 text-base font-medium text-text-body">
            <li>
              <a
                href="/services"
                class="hover:text-brand-hover transition-colors min-h-[44px] inline-flex items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded"
              >
                Services
              </a>
            </li>
            <li>
              <a
                href="/work"
                class="hover:text-brand-hover transition-colors min-h-[44px] inline-flex items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded"
              >
                Our Work
              </a>
            </li>
            <li>
              <a
                href="/about"
                class="hover:text-brand-hover transition-colors min-h-[44px] inline-flex items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded"
              >
                About
              </a>
            </li>
            <li>
              <a
                href="/why-choose-us"
                class="hover:text-brand-hover transition-colors min-h-[44px] inline-flex items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded"
              >
                Why Choose Us
              </a>
            </li>
            <li>
              <a
                href="/blog"
                class="hover:text-brand-hover transition-colors min-h-[44px] inline-flex items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded"
              >
                Blog & Insights
              </a>
            </li>
            <li>
              <a
                href="/contact"
                class="hover:text-brand-hover transition-colors min-h-[44px] inline-flex items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded"
              >
                Contact
              </a>
            </li>
          </ul>
        </div>

        <!-- Social & Email Icons -->
        <div class="flex items-center gap-3 flex-shrink-0" aria-label="Social and email profiles">
          {SITE.linkedinUrl && (
            <a
              href={SITE.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 min-w-[44px] min-h-[44px] inline-flex items-center justify-center rounded-lg border border-hairline text-text-body hover:text-brand-hover hover:border-brand-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
              aria-label="SKYON IT SOLUTIONS on LinkedIn"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64a1.65 1.65 0 0 0-1.66 1.66 1.66 1.66 0 0 0 1.66 1.66 1.66 1.66 0 0 0 1.66-1.66Z" />
              </svg>
            </a>
          )}
          {SITE.instagramUrl && (
            <a
              href={SITE.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 min-w-[44px] min-h-[44px] inline-flex items-center justify-center rounded-lg border border-hairline text-text-body hover:text-brand-hover hover:border-brand-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
              aria-label="SKYON IT SOLUTIONS on Instagram"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069ZM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0Zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881Z" />
              </svg>
            </a>
          )}
          {SITE.email && (
            <a
              href={`mailto:${SITE.email}`}
              class="w-11 h-11 min-w-[44px] min-h-[44px] inline-flex items-center justify-center rounded-lg border border-hairline text-text-body hover:text-brand-hover hover:border-brand-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
              aria-label="Email SKYON IT SOLUTIONS"
            >
              <svg class="w-5 h-5 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- ROW 2: Service Links (One/Two lines, 14px text-muted, 20px gap) -->
      <div class="mt-6">
        <h2 class="sr-only">Services</h2>
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-text-muted">
          {SERVICES.map((service) => (
            <li>
              <a
                href={`/services/${service.slug}`}
                class="hover:text-brand-hover transition-colors min-h-[44px] inline-flex items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded"
              >
                {service.shortTitle}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <!-- DIVIDER: 1px hairline, 24px above & below -->
    <div class="border-t border-hairline my-6" role="separator" aria-hidden="true"></div>

    <!-- ROW 3: Legal Navigation & Copyright -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-sm text-text-muted">
      <nav aria-label="Legal">
        <ul class="flex flex-wrap items-center gap-7">
          <li>
            <a
              href="/privacy"
              class="hover:text-brand-hover transition-colors min-h-[44px] inline-flex items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded"
            >
              Privacy Policy
            </a>
          </li>
          <li>
            <a
              href="/terms"
              class="hover:text-brand-hover transition-colors min-h-[44px] inline-flex items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded"
            >
              Terms of Service
            </a>
          </li>
          <li>
            <button
              type="button"
              id="open-feedback-btn"
              class="hover:text-brand-hover transition-colors min-h-[44px] inline-flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded text-sm text-text-muted cursor-pointer"
            >
              <span>Feedback</span>
              <span class="text-[10px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-brand-primary/10 text-brand-primary">
                Share
              </span>
            </button>
          </li>
        </ul>
      </nav>

      <p class="text-sm text-text-muted">
        &copy; {currentYear} SKYON IT SOLUTIONS. All rights reserved.
      </p>
    </div>
  </div>

  <FeedbackModal />
</footer>
