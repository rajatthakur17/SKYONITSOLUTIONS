---
import Logo from '../ui/Logo.astro';
import { SERVICE_GROUPS } from '../../data/services';
---

<header class="fixed top-0 w-full z-50 isolate bg-canvas border-b border-hairline h-16" style="isolation: isolate;">
  <div class="max-w-[72rem] mx-auto px-4 md:px-8 h-full flex items-center justify-between">
    
    <div class="flex-shrink-0">
      <Logo variant="header" />
    </div>

    <nav class="hidden md:flex items-center gap-8" aria-label="Desktop Navigation">
      <!-- Services Dropdown -->
      <div class="relative">
        <button 
          id="desktop-services-trigger"
          class="text-sm font-medium text-text-body hover:text-brand-hover transition-colors flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded"
          aria-expanded="false"
          aria-controls="desktop-services-dropdown"
        >
          Services
          <svg id="desktop-services-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div 
          id="desktop-services-dropdown"
          class="absolute top-full left-1/2 -translate-x-1/2 mt-6 w-[640px] bg-surface-1 border border-hairline rounded-lg shadow-2xl opacity-0 invisible transform -translate-y-2 transition-all duration-200 z-50 cursor-default"
          role="region"
          aria-label="Services Menu"
        >
          <div class="p-8">
            <a href="/services" class="desktop-dropdown-link mb-6 inline-flex text-sm font-semibold text-brand-primary hover:text-brand-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded">Explore all services <span aria-hidden="true" class="ml-1">&rarr;</span></a>
            <div class="grid grid-cols-2 gap-10">
              {SERVICE_GROUPS.map((group) => (
                <div>
                  <h3 class="text-xs font-bold text-brand-primary tracking-widest uppercase mb-4">{group.title}</h3>
                  <ul class="space-y-3">
                    {group.services.map((service) => (
                      <li>
                        <a href={`/services/${service.slug}`} class="text-sm font-medium text-text-primary hover:text-brand-hover transition-colors block desktop-dropdown-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded">
                          {service.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
      
      <a href="/work" class="text-sm font-medium text-text-body hover:text-brand-hover transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded">Work</a>
      <a href="/about" class="text-sm font-medium text-text-body hover:text-brand-hover transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded">About</a>
      <a href="/why-choose-us" class="text-sm font-medium text-text-body hover:text-brand-hover transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded">Why Us</a>
      <a href="/insights" class="text-sm font-medium text-text-body hover:text-brand-hover transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded">Insights</a>
      <a href="/contact" class="text-sm font-semibold bg-button-fill text-button-text px-4 py-2 rounded-full hover:bg-button-hover transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary">
        Start a Project
      </a>
    </nav>

    <div class="md:hidden flex items-center">
      <button 
        id="mobile-menu-trigger" 
        class="text-text-primary p-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded"
        aria-expanded="false" 
        aria-controls="mobile-drawer"
        aria-label="Open navigation menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
    
  </div>
</header>
<script>
  const desktopTrigger = document.getElementById('desktop-services-trigger') as HTMLButtonElement | null;
  const desktopDropdown = document.getElementById('desktop-services-dropdown') as HTMLDivElement | null;
  const desktopIcon = document.getElementById('desktop-services-icon') as SVGSVGElement | null;
  const desktopLinks = document.querySelectorAll('.desktop-dropdown-link');
  let isDesktopOpen = false;

  function toggleDesktopDropdown(e?: Event) {
    if(e) { e.stopPropagation(); }
    if (!desktopTrigger || !desktopDropdown || !desktopIcon) return;

    isDesktopOpen = !isDesktopOpen;
    desktopTrigger.setAttribute('aria-expanded', isDesktopOpen.toString());
    
    if (isDesktopOpen) {
      desktopDropdown.classList.remove('invisible', 'opacity-0', '-translate-y-2');
      desktopDropdown.classList.add('opacity-100', 'translate-y-0');
      desktopIcon.classList.add('rotate-180');
      desktopTrigger.classList.add('text-brand-primary');
      desktopTrigger.classList.remove('text-text-body');
    } else {
      desktopDropdown.classList.add('opacity-0', '-translate-y-2');
      desktopDropdown.classList.remove('opacity-100', 'translate-y-0');
      desktopIcon.classList.remove('rotate-180');
      desktopTrigger.classList.remove('text-brand-primary');
      desktopTrigger.classList.add('text-text-body');
      
      setTimeout(() => {
        if (!isDesktopOpen) desktopDropdown.classList.add('invisible');
      }, 200);
    }
  }

  function closeDesktopDropdown() {
    if(isDesktopOpen) toggleDesktopDropdown();
  }

  if (desktopTrigger) {
    desktopTrigger.addEventListener('click', toggleDesktopDropdown);
  }

  // Click outside
  document.addEventListener('click', (e) => {
    if (isDesktopOpen && desktopDropdown && desktopTrigger) {
      const target = e.target as Node;
      if (!desktopDropdown.contains(target) && !desktopTrigger.contains(target)) {
        closeDesktopDropdown();
      }
    }
  });

  // Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isDesktopOpen) {
      closeDesktopDropdown();
      if (desktopTrigger) desktopTrigger.focus();
    }
  });

  // Link clicks
  desktopLinks.forEach(link => {
    link.addEventListener('click', closeDesktopDropdown);
  });
</script>
