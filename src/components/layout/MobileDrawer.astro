---
import Logo from '../ui/Logo.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import { SERVICE_GROUPS } from '../../data/services';
---

<div 
  id="mobile-drawer" 
  class="fixed inset-0 z-50 invisible opacity-0 transition-opacity duration-200"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation"
>
  <!-- Backdrop -->
  <div 
    id="drawer-backdrop" 
    class="absolute inset-0 bg-canvas/60 backdrop-blur-sm"
    aria-hidden="true"
  ></div>

  <!-- Drawer content -->
  <div 
    id="drawer-panel" 
    class="absolute right-0 top-0 bottom-0 w-[85vw] max-w-[24rem] bg-surface-1 border-l border-hairline shadow-2xl translate-x-full transition-transform duration-300 ease-out flex flex-col"
  >
    <div class="flex items-center justify-between h-16 px-4 sm:px-6 border-b border-hairline">
      <Logo />
      <button 
        id="drawer-close" 
        class="text-text-body hover:text-brand-hover p-2 min-w-[44px] min-h-[44px] flex items-center justify-center rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary transition-colors cursor-pointer"
        aria-label="Close navigation menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto px-4 sm:px-6 py-6 sm:py-8 flex flex-col gap-5 sm:gap-6" style="-webkit-overflow-scrolling: touch;">
      
      <!-- Mobile Services Group -->
      <div>
        <button 
          id="mobile-services-trigger"
          class="w-full flex items-center justify-between text-xl sm:text-2xl font-semibold text-text-primary hover:text-brand-hover transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded"
          aria-expanded="false"
          aria-controls="mobile-services-list"
        >
          Services
          <svg id="mobile-services-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        
        <div id="mobile-services-list" class="hidden flex-col gap-3 mt-4 pl-4 border-l border-brand-primary/30" role="region" aria-label="Services Menu">
          <a href="/services" class="text-sm sm:text-base font-semibold text-brand-primary hover:text-brand-hover transition-colors drawer-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded">Explore all services</a>
          {SERVICE_GROUPS.map((group) => (
            <div class="flex flex-col gap-3">
              <div class="text-[11px] font-bold uppercase tracking-wider text-brand-primary pt-2">{group.title}</div>
              {group.services.map((service) => (
                <a href={`/services/${service.slug}`} class="text-sm sm:text-base font-medium text-text-primary hover:text-brand-hover transition-colors drawer-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded">{service.shortTitle}</a>
              ))}
            </div>
          ))}
        </div>
      </div>

      <a href="/work" class="text-xl sm:text-2xl font-semibold text-text-primary hover:text-brand-hover transition-colors drawer-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded">Our Work</a>
      <a href="/about" class="text-xl sm:text-2xl font-semibold text-text-primary hover:text-brand-hover transition-colors drawer-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded">About</a>
      <a href="/why-choose-us" class="text-xl sm:text-2xl font-semibold text-text-primary hover:text-brand-hover transition-colors drawer-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded">Why Us</a>
      <a href="/blog" class="text-xl sm:text-2xl font-semibold text-text-primary hover:text-brand-hover transition-colors drawer-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded">Blog & Insights</a>
      
      <div class="mt-6 sm:mt-8 pt-6 sm:pt-8 border-t border-hairline flex items-center gap-3">
        <a href="/contact" class="flex-1 text-center text-base sm:text-lg font-semibold bg-button-fill text-button-text px-4 sm:px-6 py-3 rounded-full hover:bg-button-hover transition-colors drawer-link">
          Start a Project
        </a>
        <ThemeToggle id="drawer-theme-toggle" />
      </div>
    </nav>
  </div>
</div>

<script>
  const trigger = document.getElementById('mobile-menu-trigger') as HTMLButtonElement | null;
  const drawer = document.getElementById('mobile-drawer') as HTMLDivElement | null;
  const panel = document.getElementById('drawer-panel') as HTMLDivElement | null;
  const closeBtn = document.getElementById('drawer-close') as HTMLButtonElement | null;
  const backdrop = document.getElementById('drawer-backdrop') as HTMLDivElement | null;
  const links = document.querySelectorAll('.drawer-link');
  
  let isOpen = false;
  let previousFocus: HTMLElement | null = null;

  function openDrawer() {
    if (isOpen || !drawer || !panel || !trigger || !closeBtn) return;
    
    // Save previous focus
    previousFocus = document.activeElement as HTMLElement | null;
    
    isOpen = true;
    
    // Disable body scroll
    document.body.style.overflow = 'hidden';
    
    // Update ARIA
    trigger.setAttribute('aria-expanded', 'true');
    drawer.setAttribute('aria-hidden', 'false');
    
    // Make visible and animate
    drawer.classList.remove('invisible');
    drawer.classList.remove('opacity-0');
    drawer.classList.add('opacity-100');
    
    setTimeout(() => {
      panel.classList.remove('translate-x-full');
      panel.classList.add('translate-x-0');
      // Set focus to the first focusable element inside drawer
      closeBtn.focus();
    }, 10);
  }

  function closeDrawer() {
    if (!isOpen || !drawer || !panel || !trigger) return;
    isOpen = false;
    
    // Restore body scroll
    document.body.style.overflow = '';
    
    // Update ARIA
    trigger.setAttribute('aria-expanded', 'false');
    drawer.setAttribute('aria-hidden', 'true');
    
    // Animate out
    panel.classList.remove('translate-x-0');
    panel.classList.add('translate-x-full');
    
    setTimeout(() => {
      drawer.classList.remove('opacity-100');
      drawer.classList.add('opacity-0');
      
      setTimeout(() => {
        drawer.classList.add('invisible');
        // Restore focus
        if (previousFocus) {
          previousFocus.focus();
        }
      }, 200);
    }, 100);
  }

  // Event Listeners
  if (trigger) trigger.addEventListener('click', openDrawer);
  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (backdrop) backdrop.addEventListener('click', closeDrawer);
  
  // Close on link click
  links.forEach(link => {
    link.addEventListener('click', closeDrawer);
  });

  // Keyboard navigation / Focus Trap / Esc to close
  document.addEventListener('keydown', (e) => {
    if (!isOpen || !drawer) return;
    
    if (e.key === 'Escape') {
      closeDrawer();
      return;
    }

    if (e.key === 'Tab') {
      // Find all visible focusable elements inside drawer (prevent tabbing into collapsed submenus)
      const allFocusable = Array.from(
        drawer.querySelectorAll<HTMLElement>('a[href], button, input, textarea, select, details, [tabindex]:not([tabindex="-1"])')
      );
      const visibleFocusable = allFocusable.filter(el => {
        return el.offsetParent !== null && !el.hasAttribute('disabled');
      });

      if (visibleFocusable.length === 0) return;
      
      const firstFocusable = visibleFocusable[0];
      const lastFocusable = visibleFocusable[visibleFocusable.length - 1];

      if (e.shiftKey) {
        // Shift + Tab
        if (document.activeElement === firstFocusable) {
          e.preventDefault();
          lastFocusable.focus();
        }
      } else {
        // Tab
        if (document.activeElement === lastFocusable) {
          e.preventDefault();
          firstFocusable.focus();
        }
      }
    }
  });

  // Mobile Services Toggle
  const mobileServicesTrigger = document.getElementById('mobile-services-trigger') as HTMLButtonElement | null;
  const mobileServicesList = document.getElementById('mobile-services-list') as HTMLDivElement | null;
  const mobileServicesIcon = document.getElementById('mobile-services-icon') as SVGSVGElement | null;
  let isMobileServicesOpen = false;

  function toggleMobileServices(e?: Event) {
    if(e) { e.stopPropagation(); }
    if (!mobileServicesTrigger || !mobileServicesList || !mobileServicesIcon) return;
    
    isMobileServicesOpen = !isMobileServicesOpen;
    mobileServicesTrigger.setAttribute('aria-expanded', isMobileServicesOpen.toString());
    
    if (isMobileServicesOpen) {
      mobileServicesList.classList.remove('hidden');
      mobileServicesList.classList.add('flex');
      mobileServicesIcon.classList.add('rotate-180');
      mobileServicesTrigger.classList.add('text-brand-primary');
    } else {
      mobileServicesList.classList.add('hidden');
      mobileServicesList.classList.remove('flex');
      mobileServicesIcon.classList.remove('rotate-180');
      mobileServicesTrigger.classList.remove('text-brand-primary');
    }
  }

  if (mobileServicesTrigger) {
    mobileServicesTrigger.addEventListener('click', toggleMobileServices);
  }
</script>
