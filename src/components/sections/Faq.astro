---
const faqs = [
  {
    q: 'What services do you offer?',
    a: 'We specialize in Website Development, Search Engine Optimization (SEO), Digital Marketing, and Social Media Management.'
  },
  {
    q: 'How long does a typical website project take?',
    a: 'Website timelines depend on the scope, content, and requirements of the project.'
  },
  {
    q: 'Will my website be optimized for mobile?',
    a: 'Yes. Websites are built with responsive layouts as a core requirement, ensuring a high-quality experience across mobile phones, tablets, and desktops.'
  },
  {
    q: 'How do you measure SEO success?',
    a: 'We can track relevant metrics such as organic traffic, engagement, and conversions when appropriate measurement and analytics are available.'
  },
  {
    q: 'Do you provide ongoing support?',
    a: 'Yes, we offer ongoing maintenance and marketing retainers to support your digital presence after the initial launch.'
  }
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="py-24 px-4 md:px-8 border-b border-hairline">
  <div class="max-w-[48rem] mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-text-primary mb-4 tracking-tight">Frequently Asked Questions</h2>
    </div>

    <div class="space-y-4 faq-container">
      {faqs.map((faq) => (
        <details class="group border border-hairline bg-surface-1 rounded-lg [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between p-6 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded-lg text-text-primary font-bold text-lg hover:text-brand-hover transition-colors">
            {faq.q}
            <span class="transition-transform duration-300 group-open:-rotate-180">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="p-6 pt-0 text-text-body">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  // Accordion exclusive open logic
  const detailsElements = document.querySelectorAll('.faq-container details');
  
  detailsElements.forEach((targetDetail) => {
    targetDetail.addEventListener('click', () => {
      detailsElements.forEach((detail) => {
        if (detail !== targetDetail) {
          detail.removeAttribute('open');
        }
      });
    });
  });
</script>
