---
const faqs = [
  {
    q: 'What services do you offer?',
    a: 'We specialize in Website Development, Search Engine Optimization (SEO), Digital Marketing, and Social Media Management.'
  },
  {
    q: 'How long does a typical website project take?',
    a: 'Website timelines depend on the scope, content, and requirements of the project.'
  },
  {
    q: 'Will my website be optimized for mobile?',
    a: 'Yes. Websites are built with responsive layouts as a core requirement, ensuring a high-quality experience across mobile phones, tablets, and desktops.'
  },
  {
    q: 'How do you measure SEO success?',
    a: 'We can track relevant metrics such as organic traffic, engagement, and conversions when appropriate measurement and analytics are available.'
  },
  {
    q: 'Do you provide ongoing support?',
    a: 'Yes, we offer ongoing maintenance and marketing retainers to support your digital presence after the initial launch.'
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

{/* FAQ JSON-LD structured data — unchanged for SEO */}
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="faq-section py-16 md:py-24 px-4 md:px-8 border-b border-hairline">
  {/* Decorative background glyph — purely visual */}
  <span class="faq-bg-glyph" aria-hidden="true">?</span>

  <div class="max-w-[48rem] mx-auto">
    <div class="text-center mb-10 md:mb-16">
      <p class="text-xs font-bold text-brand-primary uppercase tracking-widest mb-3">Clarity &amp; Terms</p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-text-primary mb-4 tracking-tight leading-tight">
        Frequently Asked Questions
      </h2>
    </div>

    <div class="space-y-4 faq-container">
      {faqs.map((faq) => (
        <details class="faq-item group border border-hairline bg-surface-1 rounded-lg [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between p-4 sm:p-6 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded-lg text-text-primary font-bold text-base sm:text-lg hover:text-brand-hover transition-colors">
            <span class="pr-3">{faq.q}</span>
            <span class="transition-transform duration-300 group-open:-rotate-180 shrink-0">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="p-4 sm:p-6 pt-0 sm:pt-0 text-text-body text-sm sm:text-base">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Section wrapper ───────────────────────────── */
  .faq-section {
    position: relative;
    overflow: hidden;
  }

  /* ── Decorative background glyph ──────────────── */
  .faq-bg-glyph {
    position: absolute;
    top: 50%;
    right: -2rem;
    transform: translateY(-50%);
    font-size: 22rem;
    font-weight: 900;
    line-height: 1;
    color: var(--color-brand-primary);
    opacity: 0.035;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  /* Keep content above the decorative glyph */
  .faq-section > .max-w-\[48rem\] {
    position: relative;
    z-index: 1;
  }

  /* ── Open-state accent border ──────────────────── */
  .faq-item {
    transition: border-color 0.2s;
  }

  /* Left accent border when open */
  .faq-item[open] {
    border-left-width: 3px;
    border-left-color: var(--color-brand-primary);
    border-radius: 0 0.5rem 0.5rem 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item {
      transition: none;
    }
  }
</style>

<script>
  // Accordion exclusive-open logic — unchanged
  const detailsElements = document.querySelectorAll('.faq-container details');

  detailsElements.forEach((targetDetail) => {
    targetDetail.addEventListener('click', () => {
      detailsElements.forEach((detail) => {
        if (detail !== targetDetail) {
          detail.removeAttribute('open');
        }
      });
    });
  });
</script>
