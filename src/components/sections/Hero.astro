---
import { Image } from 'astro:assets';
import skylineBackground from '../../../backgoundim/Futuristic Skyline with Neon Light Trails.png';
---

<section id="top" class="hero-section backdrop-01-hero">
  <Image
    src={skylineBackground}
    alt=""
    aria-hidden="true"
    class="hero-background"
    loading="eager"
  />

  <div class="hero-layout">
    <div class="hero-copy">
      

      <h1 class="hero-animate hero-animate-1">
        Build your digital presence.<br />
        <span class="hero-highlight">Grow your business.</span>
      </h1>

      <p class="hero-subline hero-animate hero-animate-2">
        Websites, SEO, digital marketing and social media to help your business build a stronger online presence.
      </p>

      <div class="hero-actions hero-animate hero-animate-3">
        <a href="/contact" class="hero-button hero-button-primary">Start a Project</a>
        <a href="/services" class="hero-button hero-button-secondary">
          Explore services
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
            <path
              d="M4 10h11M10 5l5 5-5 5"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>

      <dl class="hero-stats hero-animate hero-animate-4" aria-label="Company statistics">
        <div>
          <dt class="stat-counter" data-target="20" data-suffix="+">20+</dt>
          <dd>Projects delivered</dd>
        </div>
        <div>
          <dt class="stat-counter" data-target="9" data-suffix="">9</dt>
          <dd>Service areas</dd>
        </div>
        <div>
          <dt class="stat-counter" data-target="99.9" data-suffix="%" data-decimals="1">99.9%</dt>
          <dd>Uptime target</dd>
        </div>
        <div>
          <dt>India + Global</dt>
          <dd>Markets served</dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="hero-audiences" aria-label="Customer segments">
    <span>Working with</span>
    <ul>
      
      <li>Real estate</li>
      <li>Hospitality</li>
      <li>Jewellers</li>
      <li>Clinics</li>
      <li>SMEs &amp; startups</li>
      <li>International teams</li>
    </ul>
  </div>
</section>

<style>
  /* ── Section shell ─────────────────────────────── */
  .hero-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--color-hairline);
    background-color: var(--color-canvas);
  }

  .hero-section::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--overlay-hero);
    content: '';
    pointer-events: none;
  }

  /* ── Background image ──────────────────────────── */
  .hero-background {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
    opacity: 0.78;
    pointer-events: none;
  }

  /* ── Layout ────────────────────────────────────── */
  .hero-layout {
    position: relative;
    z-index: 1;
    max-width: 64rem;
    margin-inline: auto;
    padding: 4.25rem 2rem 3.5rem;
  }

  .hero-copy {
    max-width: 64rem;
  }

  /* ── Eyebrow ───────────────────────────────────── */
  .hero-eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-brand-primary);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* ── Headline ──────────────────────────────────── */
  .hero-copy h1 {
    font-size: clamp(3rem, 7.5vw, 6.25rem);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin: 0 0 1.5rem;
    color: var(--color-text-primary);
  }

  .hero-highlight {
    color: var(--color-brand-primary);
  }

  /* ── Subline ───────────────────────────────────── */
  .hero-subline {
    max-width: 40rem;
    margin: 0 0 2rem;
    color: var(--color-text-body);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* ── Actions ───────────────────────────────────── */
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.25rem;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s;
  }

  .hero-button-primary {
    background: var(--color-button-fill);
    color: var(--color-button-text);
  }

  .hero-button-primary:hover {
    background: var(--color-button-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(184, 240, 77, 0.22);
  }

  .hero-button-secondary {
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface-1);
    color: var(--color-text-primary);
  }

  .hero-button-secondary:hover {
    border-color: var(--color-brand-primary);
    color: var(--color-brand-hover);
  }

  .hero-button svg {
    width: 1rem;
    height: 1rem;
  }

  /* ── Stats strip ───────────────────────────────── */
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.75rem;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-hairline);
  }

  .hero-stats dt {
    color: var(--color-text-primary);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .hero-stats dd {
    margin: 0.2rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  /* ── Audiences ─────────────────────────────────── */
  .hero-audiences {
    position: relative;
    z-index: 1;
    display: flex;
    max-width: 72rem;
    align-items: center;
    gap: 1.25rem;
    margin: 0 auto;
    padding: 1.1rem 2rem;
    border-top: 1px solid var(--color-hairline);
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .hero-audiences > span {
    flex: none;
    font-weight: 700;
  }

  .hero-audiences ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-audiences li::before {
    content: '';
    display: inline-block;
    width: 0.32rem;
    height: 0.32rem;
    margin: 0 0.45rem 0.08rem 0;
    border-radius: 50%;
    background: var(--color-brand-primary);
  }

  /* ── Entrance animations ───────────────────────── */
  @keyframes fadeUpIn {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-animate {
    animation: fadeUpIn 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero-animate-1 { animation-delay: 0.05s; }
  .hero-animate-2 { animation-delay: 0.2s;  }
  .hero-animate-3 { animation-delay: 0.35s; }
  .hero-animate-4 { animation-delay: 0.5s;  }

  @media (prefers-reduced-motion: reduce) {
    .hero-animate {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* ── Responsive ────────────────────────────────── */
  @media (max-width: 63.99rem) {
    .hero-layout {
      padding: 3.25rem 2rem 2.5rem;
    }
  }

  @media (max-width: 39.99rem) {
    .hero-layout {
      padding: 1.75rem 1rem 1.25rem;
    }

    .hero-copy h1 {
      font-size: clamp(2.15rem, 8.5vw, 3.25rem);
      line-height: 1.02;
      margin-bottom: 1.25rem;
    }

    .hero-subline {
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
    }

    .hero-actions {
      gap: 0.65rem;
      margin-bottom: 1.75rem;
    }

    .hero-button {
      flex: 1 1 130px;
      min-height: 48px;
      padding-inline: 1rem;
      font-size: 0.875rem;
      justify-content: center;
    }

    .hero-stats {
      gap: 1rem 1.75rem;
      padding-top: 1.15rem;
    }

    .hero-stats dt {
      font-size: 1.1rem;
    }

    .hero-background {
      object-position: 70% center;
    }

    .hero-audiences {
      display: none;
    }
  }

  @media (max-width: 22rem) {
    .hero-actions {
      flex-direction: column;
    }
    .hero-button {
      width: 100%;
    }
  }
</style>

<script>
  // Stat counter animation — fires when stats scroll into view
  function initCounters() {
    const counters = document.querySelectorAll('.stat-counter');
    if (!counters.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return; // Respect reduced motion preference
    }

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          obs.unobserve(entry.target);

          const el = entry.target as HTMLElement;
          const target = parseFloat(el.getAttribute('data-target') || '0');
          const suffix = el.getAttribute('data-suffix') || '';
          const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
          const duration = 1400;
          const startTime = performance.now();

          function step(now: number) {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const ease = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
            const current = target * ease;

            el.textContent =
              (decimals > 0
                ? current.toFixed(decimals)
                : Math.round(current).toString()) + suffix;

            if (progress < 1) {
              requestAnimationFrame(step);
            } else {
              el.textContent =
                (decimals > 0 ? target.toFixed(decimals) : target.toString()) +
                suffix;
            }
          }

          requestAnimationFrame(step);
        });
      },
      { threshold: 0.2 }
    );

    counters.forEach((c) => observer.observe(c));
  }

  initCounters();
  document.addEventListener('astro:page-load', initCounters);
</script>
