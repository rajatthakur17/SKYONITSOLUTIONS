---
import { Image } from 'astro:assets';
import workspaceBackground from '../../../backgoundim/Neon Blue Digital Workspace Portfolio.png';
import myMarriageBiodataImg from '../../assets/work/mymarriagebiodata.png';
import { WORK_ITEMS, CUMULATIVE_WORK_STATS, WORK_METHODOLOGY } from '../../data/work';

interface Props {
  isPage?: boolean;
}

const { isPage = false } = Astro.props;
---
<section id="work" class={`work-section ${isPage ? 'py-16 md:py-24 bg-canvas' : 'backdrop-06-work py-20 md:py-24'} px-4 md:px-8 border-b border-hairline`}>
  {!isPage && (
    <Image
      src={workspaceBackground}
      alt=""
      aria-hidden="true"
      class="work-background"
      loading="lazy"
    />
  )}
  <div class="relative z-1 max-w-[72rem] mx-auto">
    {!isPage ? (
      <div class="mb-14">
        <p class="text-xs font-bold text-brand-primary uppercase tracking-widest mb-3">Portfolio &amp; Case Proof</p>
        <h2 class="text-3xl md:text-5xl font-bold text-text-primary mb-4 tracking-tight">Featured Work &amp; Case Proof</h2>
        <p class="text-lg text-text-body max-w-[42rem]">
          Demonstrated engineering delivery across authorized commercial client platforms and internal digital products.
        </p>
      </div>
    ) : (
      <div class="mb-16">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 p-6 bg-surface-1 border border-hairline rounded-lg">
          {CUMULATIVE_WORK_STATS.map((stat) => (
            <div class="p-4 flex flex-col justify-between">
              <span class="font-mono text-3xl md:text-4xl font-extrabold text-brand-primary tracking-tight">
                {stat.value}
              </span>
              <span class="text-xs font-bold text-text-primary uppercase tracking-wider mt-2">
                {stat.label}
              </span>
              <p class="text-xs text-text-muted mt-1 leading-snug border-t border-hairline pt-2">
                {stat.context}
              </p>
            </div>
          ))}
        </div>
      </div>
    )}

    {isPage && (
      <div class="mb-10 flex flex-wrap items-center justify-between gap-4 border-b border-hairline pb-4">
        <div class="flex items-center gap-2" id="work-filter-tabs">
          <button
            type="button"
            data-filter="all"
            class="work-tab-btn active px-4 py-2 rounded-full text-xs font-bold transition-colors bg-brand-primary text-white"
          >
            All Work ({WORK_ITEMS.length})
          </button>
          <button
            type="button"
            data-filter="CLIENT"
            class="work-tab-btn px-4 py-2 rounded-full text-xs font-bold transition-colors bg-surface-1 text-text-body border border-hairline hover:border-brand-primary/40 hover:text-text-primary"
          >
            Client Platforms
          </button>
          <button
            type="button"
            data-filter="PRODUCT"
            class="work-tab-btn px-4 py-2 rounded-full text-xs font-bold transition-colors bg-surface-1 text-text-body border border-hairline hover:border-brand-primary/40 hover:text-text-primary"
          >
            Internal Products &amp; SaaS
          </button>
        </div>
        <span class="text-xs text-text-muted font-mono">
          Showing verified production deliveries
        </span>
      </div>
    )}

    <div class="space-y-16" id="work-grid">
      {WORK_ITEMS.map((item) => (
        <article
          class="work-card border border-hairline bg-surface-1 rounded-xl overflow-hidden shadow-xs hover:border-brand-primary/40 transition-colors"
          data-category={item.category}
        >
          <div class="grid grid-cols-1 lg:grid-cols-12">
            <div class="lg:col-span-6 bg-canvas border-b lg:border-b-0 lg:border-r border-hairline p-6 md:p-8 flex flex-col justify-center">
              <div class="rounded-lg border border-hairline bg-surface-1 overflow-hidden shadow-sm">
                <div class="bg-surface-2 px-4 py-2.5 border-b border-hairline flex items-center gap-3">
                  <div class="flex items-center gap-1.5" aria-hidden="true">
                    <span class="w-2.5 h-2.5 rounded-full bg-red-500/80 inline-block"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80 inline-block"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-green-500/80 inline-block"></span>
                  </div>
                  <div class="flex-1 bg-canvas border border-hairline rounded px-3 py-1 text-[11px] font-mono text-text-muted truncate flex items-center justify-between">
                    <span class="truncate">{item.liveUrl}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 shrink-0 ml-1 text-text-disabled" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                  </div>
                </div>

                <div class="relative min-h-[220px] md:min-h-[280px] bg-canvas flex items-center justify-center overflow-hidden">
                  {item.id === 'mymarriagebiodata' ? (
                    <Image
                      src={myMarriageBiodataImg}
                      alt={item.imageAlt}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover object-top opacity-95 hover:scale-102 transition-transform duration-500"
                    />
                  ) : (
                    <div class="p-8 text-center flex flex-col items-center justify-center w-full h-full bg-surface-1/40">
                      <div class="w-12 h-12 rounded-full bg-brand-primary/10 border border-brand-primary/30 flex items-center justify-center text-brand-primary mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                      </div>
                      <span class="text-xs font-mono font-bold uppercase tracking-wider text-brand-primary mb-1">
                        {item.clientBadge}
                      </span>
                      <h4 class="text-xl font-extrabold text-text-primary mb-2">{item.title}</h4>
                      <p class="text-xs text-text-muted max-w-[20rem] leading-relaxed mb-4">
                        {item.summary}
                      </p>
                      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-canvas border border-hairline text-[11px] font-mono text-text-primary">
                        <span>Status:</span>
                        <span class="w-2 h-2 rounded-full bg-success"></span>
                        <strong class="text-brand-primary">Live Production</strong>
                      </div>
                    </div>
                  )}
                </div>
              </div>

              <div class="grid grid-cols-3 gap-2 mt-4 pt-4 border-t border-hairline text-center">
                {item.metrics.map((m) => (
                  <div class="p-2 rounded bg-surface-1 border border-hairline">
                    <span class="block font-mono text-base md:text-lg font-extrabold text-brand-primary">
                      {m.value}
                    </span>
                    <span class="block text-[10px] text-text-muted uppercase tracking-tight mt-0.5">
                      {m.label}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            <div class="lg:col-span-6 p-6 md:p-10 flex flex-col justify-between">
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-4">
                  <span class="px-2.5 py-0.5 bg-brand-primary/10 text-brand-primary text-xs font-bold tracking-widest uppercase rounded">
                    {item.clientBadge}
                  </span>
                  <span class="text-xs font-mono text-text-muted">
                    • {item.sector}
                  </span>
                </div>

                <h3 class="text-2xl md:text-3xl font-extrabold text-text-primary mb-3">
                  {item.title}
                </h3>
                <p class="text-text-body text-sm leading-relaxed mb-6">
                  {item.summary}
                </p>

                <div class="space-y-4 mb-6">
                  <div class="p-4 rounded-lg bg-canvas border border-hairline">
                    <h4 class="text-xs font-bold text-brand-primary uppercase tracking-wider mb-1 flex items-center gap-1.5">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                      </svg>
                      The Challenge
                    </h4>
                    <p class="text-xs text-text-body leading-relaxed">{item.challenge}</p>
                  </div>

                  <div class="p-4 rounded-lg bg-canvas border border-hairline">
                    <h4 class="text-xs font-bold text-success uppercase tracking-wider mb-1 flex items-center gap-1.5">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      The Engineering Solution
                    </h4>
                    <p class="text-xs text-text-body leading-relaxed">{item.solution}</p>
                  </div>
                </div>

                <div class="mb-6">
                  <h4 class="text-xs font-bold text-text-primary uppercase tracking-wider mb-2.5">
                    Engineered Outcomes
                  </h4>
                  <ul class="space-y-1.5 text-xs text-text-body">
                    {item.keyOutcomes.map((outcome) => (
                      <li class="flex items-start gap-2">
                        <span class="text-brand-primary font-bold">✓</span>
                        <span>{outcome}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mb-8">
                  <h4 class="text-xs font-bold text-text-disabled uppercase tracking-wider mb-2">
                    Architecture &amp; Tools
                  </h4>
                  <div class="flex flex-wrap gap-1.5">
                    {item.techStack.map((tech) => (
                      <span class="px-2 py-0.5 rounded bg-canvas border border-hairline text-text-body font-mono text-[11px]">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              <div class="pt-4 border-t border-hairline flex items-center justify-between">
                <a
                  href={item.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center text-sm font-bold text-brand-primary hover:text-brand-hover transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded"
                >
                  {item.liveUrlLabel}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    {isPage && (
      <div class="mt-24 pt-16 border-t border-hairline">
        <div class="mb-12">
          <p class="text-xs font-bold text-brand-primary uppercase tracking-widest mb-2">Engineering Standards</p>
          <h2 class="text-3xl md:text-4xl font-extrabold text-text-primary tracking-tight mb-4">
            How We Deliver Digital Products
          </h2>
          <p class="text-base text-text-body max-w-[42rem]">
            Every engagement follows a structured, transparent lifecycle engineered to mitigate risk, eliminate scope ambiguity, and deliver production-grade performance.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {WORK_METHODOLOGY.map((m) => (
            <div class="p-6 bg-surface-1 border border-hairline rounded-lg flex flex-col justify-between">
              <div>
                <span class="font-mono text-3xl font-extrabold text-brand-primary mb-3 block">
                  {m.step}
                </span>
                <h3 class="text-base font-bold text-text-primary mb-2">
                  {m.title}
                </h3>
                <p class="text-xs text-text-body leading-relaxed">
                  {m.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {isPage && (
      <div class="mt-20 p-8 md:p-12 bg-surface-1 border border-hairline rounded-xl flex flex-col md:flex-row items-center justify-between gap-8">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-brand-primary block mb-2">
            Start Your Engagement
          </span>
          <h3 class="text-2xl md:text-3xl font-extrabold text-text-primary mb-2">
            Have a custom web platform or software project in mind?
          </h3>
          <p class="text-sm text-text-body max-w-[36rem]">
            We provide realistic architecture roadmaps, direct WhatsApp consultations, and verified engineering timelines tailored to your scope.
          </p>
        </div>
        <div class="shrink-0 w-full md:w-auto">
          <a
            href="/contact"
            class="w-full md:w-auto inline-flex items-center justify-center bg-button-fill text-button-text px-8 py-3.5 rounded-full font-bold hover:bg-button-hover transition-colors shadow-sm min-h-[44px]"
          >
            Schedule a Consultation &rarr;
          </a>
        </div>
      </div>
    )}
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.work-tab-btn');
    if (!tabs.length) return;
    const cards = document.querySelectorAll('.work-card');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter');

        tabs.forEach((t) => {
          t.classList.remove('bg-brand-primary', 'text-white');
          t.classList.add('bg-surface-1', 'text-text-body');
        });
        tab.classList.remove('bg-surface-1', 'text-text-body');
        tab.classList.add('bg-brand-primary', 'text-white');

        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  .work-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .work-section::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--overlay-work);
    content: '';
    pointer-events: none;
  }

  .work-background {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    opacity: 0.85;
    pointer-events: none;
  }

  @media (max-width: 48rem) {
    .work-background {
      object-position: center;
    }
  }
</style>
