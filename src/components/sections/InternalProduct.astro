---
import { Image } from 'astro:assets';
import workspaceBackground from '../../../backgoundim/Neon Blue Digital Workspace Portfolio.png';
import myMarriageBiodataImg from '../../assets/work/mymarriagebiodata.png';

interface Props {
  isPage?: boolean;
}

const { isPage = false } = Astro.props;
---
<section id="work" class={`work-section ${isPage ? 'py-16 md:py-24 bg-canvas' : 'backdrop-06-work py-20 md:py-24'} px-4 md:px-8 border-b border-hairline`}>
  {!isPage && (
    <Image
      src={workspaceBackground}
      alt=""
      aria-hidden="true"
      class="work-background"
      loading="lazy"
    />
  )}
  <div class="relative z-1 max-w-[72rem] mx-auto">
    {!isPage && (
      <div class="mb-16">
        <p class="text-xs font-bold text-brand-primary uppercase tracking-widest mb-3">Portfolio &amp; Case Proof</p>
        <h2 class="text-3xl md:text-5xl font-bold text-text-primary mb-4 tracking-tight">Featured Work &amp; Case Proof</h2>
        <p class="text-lg text-text-body max-w-[42rem]">
          Demonstrated delivery across commercial client platforms and internal digital products.
        </p>
      </div>
    )}

    <div class="space-y-12">
      <!-- 1. Client Project: R4Realty.in -->
      <div class="border border-hairline bg-surface-1 rounded-lg overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12">

          <div class="lg:col-span-7 bg-canvas border-b lg:border-b-0 lg:border-r border-hairline p-8 md:p-12 flex flex-col justify-center">
            <div class="w-full h-full min-h-[220px] rounded border border-hairline bg-canvas/80 p-6 flex flex-col justify-between">
              <div>
                <span class="text-xs font-mono text-brand-primary uppercase tracking-widest block mb-2">Authorized Client Project</span>
                <h4 class="text-2xl font-extrabold text-text-primary mb-2">R4Realty.in</h4>
                <p class="text-text-body text-sm leading-relaxed">
                  A real-estate client project SKYON is authorized to feature.
                </p>
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 p-8 md:p-12 flex flex-col justify-center">
            <div class="flex items-center gap-3 mb-6">
              <span class="px-3 py-1 bg-brand-primary/10 text-brand-primary text-xs font-bold tracking-widest uppercase rounded">Authorized Client Project</span>
            </div>

            <h3 class="text-2xl font-bold text-text-primary mb-4">R4Realty.in</h3>
            <p class="mb-8 text-text-body text-sm">Visit the live project website.</p>

            <a href="https://r4realty.in/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-brand-primary font-semibold hover:text-brand-hover transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded">
              Visit R4Realty.in
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

        </div>
      </div>

      <!-- 2. Internal Product: MyMarriageBiodata -->
      <div class="border border-hairline bg-surface-1 rounded-lg overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12">

          <div class="lg:col-span-7 bg-canvas border-b lg:border-b-0 lg:border-r border-hairline relative min-h-[260px] lg:min-h-[340px] flex items-center justify-center overflow-hidden">
            <Image
              src={myMarriageBiodataImg}
              alt="Screenshot of the MyMarriageBiodata application interface"
              loading="lazy"
              decoding="async"
              class="absolute w-full h-full object-cover object-top opacity-90"
            />
          </div>

          <div class="lg:col-span-5 p-8 md:p-12 flex flex-col justify-center">
            <div class="flex items-center gap-3 mb-6">
              <span class="px-3 py-1 bg-brand-primary/10 text-brand-primary text-xs font-bold tracking-widest uppercase rounded">Internal Product</span>
            </div>

            <h3 class="text-2xl font-bold text-text-primary mb-4">MyMarriageBiodata</h3>

            <div class="mb-8 space-y-4">
              <div>
                <h4 class="text-sm font-semibold text-text-primary mb-1">What it is</h4>
                <p class="text-text-body text-sm">A free online marriage biodata creator for users across India to generate and download customized biodata PDFs.</p>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-text-primary mb-1">Architecture &amp; Stack</h4>
                <p class="text-text-body text-sm">Astro, React Islands, Tailwind CSS v4, TypeScript, jsPDF, and html2canvas.</p>
              </div>
            </div>

            <a href="https://www.mymarriagebiodata.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-brand-primary font-semibold hover:text-brand-hover transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded">
              View Live Site
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .work-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .work-section::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--overlay-work);
    content: '';
    pointer-events: none;
  }

  .work-background {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    opacity: 0.85;
    pointer-events: none;
  }

  @media (max-width: 48rem) {
    .work-background {
      object-position: center;
    }
  }
</style>
