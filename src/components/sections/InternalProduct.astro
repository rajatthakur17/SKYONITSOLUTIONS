---
---
<section id="work" class="py-24 px-4 md:px-8 border-b border-hairline bg-surface-1/30">
  <div class="max-w-[72rem] mx-auto">
    <div class="mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-text-primary mb-4 tracking-tight">Selected Work</h2>
      <p class="text-lg text-text-body max-w-[42rem]">
        A look at our execution capabilities.
      </p>
    </div>

    <div class="border border-hairline bg-surface-1 rounded-lg overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12">
        
        <!-- Image / Placeholder Side -->
        <div class="lg:col-span-7 bg-canvas border-b lg:border-b-0 lg:border-r border-hairline relative min-h-[300px] lg:min-h-[400px] flex items-center justify-center overflow-hidden">
          <img 
            src="/brand/mymarriagebiodata.png" 
            alt="MyMarriageBiodata Screenshot" 
            class="absolute w-full h-full object-cover object-top opacity-90"
          />
        </div>

        <!-- Content Side -->
        <div class="lg:col-span-5 p-8 md:p-12 flex flex-col justify-center">
          <div class="flex items-center gap-3 mb-6">
            <span class="px-3 py-1 bg-brand-primary/10 text-brand-primary text-xs font-bold tracking-widest uppercase rounded">Internal Product</span>
          </div>
          
          <h3 class="text-2xl font-bold text-text-primary mb-4">MyMarriageBiodata</h3>
          
          <div class="mb-8 space-y-4">
            <div>
              <h4 class="text-sm font-semibold text-text-primary mb-1">What it is</h4>
              <p class="text-text-body">MyMarriageBiodata is a free online marriage biodata maker for people in India who want to create and download a marriage biodata.</p>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-text-primary mb-1">What I built / stack</h4>
              <p class="text-text-body">Astro, React Islands, Tailwind CSS v4, TypeScript, jsPDF, and html2canvas.</p>
            </div>
          </div>

          <a href="https://www.mymarriagebiodata.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-brand-primary font-semibold hover:text-brand-hover transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded">
            View Live Site
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
        
      </div>
    </div>
  </div>
</section>
