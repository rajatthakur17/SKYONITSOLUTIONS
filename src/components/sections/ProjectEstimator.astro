---
// ProjectEstimator.astro — High-Converting Interactive Project Scope & WhatsApp Estimator
interface Props {
  phone?: string;
}

const { phone = '917014865202' } = Astro.props;
---

<section id="estimator" data-phone={phone} class="estimator-section py-20 md:py-28 px-4 md:px-8 border-b border-hairline relative overflow-hidden" aria-label="Interactive Project Scope Calculator">
  <!-- Ambient background glow -->
  <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[380px] bg-brand-primary/10 rounded-full blur-[150px]"></div>
    <div class="absolute bottom-10 right-10 w-[500px] h-[300px] bg-brand-primary/5 rounded-full blur-[130px]"></div>
  </div>

  <div class="max-w-[76rem] mx-auto">
    <!-- Header -->
    <div class="text-center max-w-[48rem] mx-auto mb-12 md:mb-16">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-surface-2/60 backdrop-blur-md text-brand-primary border border-hairline text-xs font-bold tracking-widest uppercase rounded-full mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-brand-primary animate-pulse"></span>
        Interactive Scope &amp; Timeline Calculator
      </span>
      <h2 class="text-3xl md:text-5xl font-extrabold text-text-primary tracking-tight leading-tight mb-4">
        Configure Your Project in 30 Seconds.
      </h2>
      <p class="text-base md:text-lg text-text-body leading-relaxed">
        Select your required service type, project scale, and integrations. Our system dynamically estimates turnaround time, architected tech stack, and generates a pre-formatted WhatsApp brief for an instant quote.
      </p>

      <!-- Step Progress Bar -->
      <div class="mt-8 flex items-center justify-center gap-1.5 sm:gap-3 text-[11px] sm:text-xs font-semibold text-text-body overflow-x-auto max-w-full pb-1">
        <span class="flex items-center gap-1 sm:gap-1.5 text-brand-primary shrink-0">
          <span class="w-5 h-5 rounded-full bg-brand-primary/20 border border-brand-primary flex items-center justify-center text-[10px] font-bold">1</span>
          Category
        </span>
        <span class="w-3 sm:w-6 md:w-8 h-[1px] bg-hairline shrink-0"></span>
        <span class="flex items-center gap-1 sm:gap-1.5 text-brand-primary shrink-0">
          <span class="w-5 h-5 rounded-full bg-brand-primary/20 border border-brand-primary flex items-center justify-center text-[10px] font-bold">2</span>
          Scale
        </span>
        <span class="w-3 sm:w-6 md:w-8 h-[1px] bg-hairline shrink-0"></span>
        <span class="flex items-center gap-1 sm:gap-1.5 text-brand-primary shrink-0">
          <span class="w-5 h-5 rounded-full bg-brand-primary/20 border border-brand-primary flex items-center justify-center text-[10px] font-bold">3</span>
          Add-ons
        </span>
        <span class="w-3 sm:w-6 md:w-8 h-[1px] bg-hairline shrink-0"></span>
        <span class="flex items-center gap-1 text-[var(--color-success)] font-bold shrink-0">
          <span class="w-5 h-5 rounded-full bg-[var(--color-success)]/20 border border-[var(--color-success)] flex items-center justify-center text-[10px]">✓</span>
          Quote
        </span>
      </div>
    </div>

    <!-- Estimator Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start" id="estimator-form">
      
      <!-- Left Column: Interactive Controls (7 cols) -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        
        <!-- Step 1: Service Type -->
        <div class="estimator-group p-4 sm:p-6 rounded-2xl bg-surface-1/90 border border-hairline backdrop-blur-md shadow-lg">
          <div class="flex items-center justify-between mb-4">
            <label class="text-xs font-bold uppercase tracking-wider text-brand-primary flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-brand-primary"></span>
              Step 1 • Select Service Category
            </label>
            <span class="text-[11px] text-text-muted">Pick engineering focus</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5" id="service-options">
            <button type="button" class="estimator-option is-active" aria-pressed="true"
                    data-service="Web Application / SaaS"
                    data-time-starter="2 - 3 Weeks"
                    data-time-growth="3 - 5 Weeks"
                    data-time-enterprise="6 - 8 Weeks"
                    data-stack="Astro + React Islands + TypeScript + Tailwind v4">
              <div class="flex items-center justify-between w-full mb-1">
                <span class="estimator-option-icon">💻</span>
                <span class="radio-indicator"></span>
              </div>
              <span class="estimator-option-label">Web App / SaaS</span>
              <span class="estimator-option-desc">Custom web portals, client platforms, dashboards</span>
            </button>
            <button type="button" class="estimator-option" aria-pressed="false"
                    data-service="High-Performance Website"
                    data-time-starter="5 - 7 Days"
                    data-time-growth="10 - 14 Days"
                    data-time-enterprise="3 - 4 Weeks"
                    data-stack="Astro + Tailwind CSS v4 + Cloudflare Edge">
              <div class="flex items-center justify-between w-full mb-1">
                <span class="estimator-option-icon">🚀</span>
                <span class="radio-indicator"></span>
              </div>
              <span class="estimator-option-label">Corporate Website</span>
              <span class="estimator-option-desc">Sub-second speeds, modern UI/UX, full SEO structure</span>
            </button>
            <button type="button" class="estimator-option" aria-pressed="false"
                    data-service="AI & Workflow Automation"
                    data-time-starter="7 - 10 Days"
                    data-time-growth="2 - 3 Weeks"
                    data-time-enterprise="4 - 6 Weeks"
                    data-stack="Python + LangChain + OpenAI APIs + Webhooks">
              <div class="flex items-center justify-between w-full mb-1">
                <span class="estimator-option-icon">🤖</span>
                <span class="radio-indicator"></span>
              </div>
              <span class="estimator-option-label">AI &amp; Automation</span>
              <span class="estimator-option-desc">WhatsApp CRM bots, automated lead workflows</span>
            </button>
            <button type="button" class="estimator-option" aria-pressed="false"
                    data-service="E-Commerce & Digital Store"
                    data-time-starter="10 - 14 Days"
                    data-time-growth="3 - 4 Weeks"
                    data-time-enterprise="5 - 7 Weeks"
                    data-stack="Headless E-Commerce + Payment Gateways + Analytics">
              <div class="flex items-center justify-between w-full mb-1">
                <span class="estimator-option-icon">🛍️</span>
                <span class="radio-indicator"></span>
              </div>
              <span class="estimator-option-label">E-Commerce Store</span>
              <span class="estimator-option-desc">High-speed checkout, catalog, payment, inventory</span>
            </button>
          </div>
        </div>

        <!-- Step 2: Scale & Stage -->
        <div class="estimator-group p-4 sm:p-6 rounded-2xl bg-surface-1/90 border border-hairline backdrop-blur-md shadow-lg">
          <div class="flex items-center justify-between mb-4">
            <label class="text-xs font-bold uppercase tracking-wider text-brand-primary flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-brand-primary"></span>
              Step 2 • Project Scale &amp; Tier
            </label>
            <span class="text-[11px] text-text-muted">Architecture depth</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5" id="scale-options">
            <button type="button" class="estimator-option is-active" aria-pressed="true"
                    data-scale="Starter MVP"
                    data-tier="Essential Launch Tier"
                    data-tag="Quick ROI">
              <div class="flex items-center justify-between w-full mb-1.5">
                <span class="text-[11px] text-brand-primary font-bold bg-surface-2 px-2 py-0.5 rounded border border-brand-primary/40">Lean MVP</span>
                <span class="radio-indicator"></span>
              </div>
              <span class="estimator-option-label font-bold">Starter MVP</span>
              <span class="estimator-option-desc">Core feature set, immediate rollout, lean cost</span>
            </button>
            <button type="button" class="estimator-option" aria-pressed="false"
                    data-scale="Growth Scale"
                    data-tier="Business Scaling Tier"
                    data-tag="Most Popular">
              <div class="flex items-center justify-between w-full mb-1.5">
                <span class="text-[11px] text-brand-primary font-bold bg-surface-2 px-2 py-0.5 rounded border border-brand-primary/40">Popular</span>
                <span class="radio-indicator"></span>
              </div>
              <span class="estimator-option-label font-bold">Growth Scale</span>
              <span class="estimator-option-desc">Scalable database, auth, integrations &amp; analytics</span>
            </button>
            <button type="button" class="estimator-option" aria-pressed="false"
                    data-scale="Enterprise"
                    data-tier="Enterprise Custom Engineering Tier"
                    data-tag="High SLA">
              <div class="flex items-center justify-between w-full mb-1.5">
                <span class="text-[11px] text-brand-primary font-bold bg-surface-2 px-2 py-0.5 rounded border border-brand-primary/40">Full SLA</span>
                <span class="radio-indicator"></span>
              </div>
              <span class="estimator-option-label font-bold">Enterprise</span>
              <span class="estimator-option-desc">Multi-tenant, high-traffic, bespoke SLA architecture</span>
            </button>
          </div>
        </div>

        <!-- Step 3: Add-ons & Integrations -->
        <div class="estimator-group p-4 sm:p-6 rounded-2xl bg-surface-1/90 border border-hairline backdrop-blur-md shadow-lg">
          <div class="flex items-center justify-between mb-4">
            <label class="text-xs font-bold uppercase tracking-wider text-brand-primary flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-brand-primary"></span>
              Step 3 • Integrations &amp; Accelerators
            </label>
            <span class="text-[11px] text-text-muted">Toggle desired features</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="addon-options">
            <button type="button" class="estimator-pill" aria-pressed="false" data-addon="WhatsApp Lead CRM Integration">
              <span class="estimator-pill-checkbox"></span>
              <span class="estimator-pill-text">💬 WhatsApp CRM Integration</span>
            </button>
            <button type="button" class="estimator-pill is-active" aria-pressed="true" data-addon="Complete Technical SEO & Schema">
              <span class="estimator-pill-checkbox"></span>
              <span class="estimator-pill-text">📈 Technical SEO &amp; Schema</span>
            </button>
            <button type="button" class="estimator-pill" aria-pressed="false" data-addon="Online Payment Gateway (Stripe/Razorpay)">
              <span class="estimator-pill-checkbox"></span>
              <span class="estimator-pill-text">💳 Payment Gateway (Razorpay/Stripe)</span>
            </button>
            <button type="button" class="estimator-pill" aria-pressed="false" data-addon="Cloud Infrastructure & CI/CD Pipeline">
              <span class="estimator-pill-checkbox"></span>
              <span class="estimator-pill-text">☁️ Cloud Hosting &amp; CI/CD</span>
            </button>
            <button type="button" class="estimator-pill" aria-pressed="false" data-addon="Custom Admin Analytics Dashboard">
              <span class="estimator-pill-checkbox"></span>
              <span class="estimator-pill-text">📊 Admin Analytics Dashboard</span>
            </button>
            <button type="button" class="estimator-pill" aria-pressed="false" data-addon="AI Chatbot / Smart Assistant">
              <span class="estimator-pill-checkbox"></span>
              <span class="estimator-pill-text">🤖 AI Chatbot / Assistant</span>
            </button>
            <button type="button" class="estimator-pill" aria-pressed="false" data-addon="Role-Based Access Control (RBAC)">
              <span class="estimator-pill-checkbox"></span>
              <span class="estimator-pill-text">🔒 Role-Based User Access</span>
            </button>
            <button type="button" class="estimator-pill is-fasttrack" aria-pressed="false" data-addon="⚡ Priority Fast-Track Launch">
              <span class="estimator-pill-checkbox"></span>
              <span class="estimator-pill-text text-brand-primary font-bold">⚡ Priority Fast-Track Launch</span>
            </button>
          </div>
        </div>

        <!-- Optional Personalization Field -->
        <div class="p-4 rounded-xl bg-surface-1/60 border border-hairline flex flex-col sm:flex-row items-center gap-3">
          <label for="client-name-input" class="text-xs font-semibold text-text-body whitespace-nowrap">
            Your Name / Company <span class="text-text-muted font-normal">(Optional)</span>:
          </label>
          <input type="text"
                 id="client-name-input"
                 placeholder="e.g. Rahul Sharma / Acme Corp"
                 class="w-full px-3.5 py-2 text-xs rounded-lg bg-surface-2 border border-border-strong text-text-primary placeholder:text-text-disabled focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/40 transition-all" />
        </div>

      </div>

      <!-- Right Column: Live Proposal Card (5 cols) -->
      <div class="lg:col-span-5 sticky top-24">
        <div class="p-5 sm:p-6 md:p-8 rounded-2xl bg-surface-1 border border-border-strong shadow-2xl backdrop-blur-xl relative overflow-hidden">
          
          <!-- Glowing decorative accent -->
          <div class="absolute -top-12 -right-12 w-44 h-44 bg-brand-primary/10 rounded-full blur-2xl pointer-events-none"></div>

          <!-- Card Header -->
          <div class="flex items-center justify-between pb-4 border-b border-hairline mb-6">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[var(--color-success)] animate-pulse"></span>
              <span class="text-xs font-bold uppercase tracking-widest text-text-primary">Live Proposal Summary</span>
            </div>
            <span id="fasttrack-badge" class="hidden text-[10px] font-bold text-brand-primary bg-surface-2 border border-brand-primary/40 px-2 py-0.5 rounded-full">
              ⚡ Fast-Track Active
            </span>
          </div>

          <!-- Configuration Details -->
          <div class="space-y-4 mb-6">
            <div>
              <span class="text-xs text-text-muted uppercase font-semibold">Configured Solution</span>
              <p id="summary-service" class="text-lg font-extrabold text-text-primary mt-0.5">Web Application / SaaS</p>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <span class="text-xs text-text-muted uppercase font-semibold">Project Tier</span>
                <p id="summary-scale" class="text-sm font-bold text-text-primary mt-0.5">Starter MVP</p>
                <span id="summary-tier" class="text-[11px] text-brand-primary block">Essential Launch Tier</span>
              </div>
              <div>
                <span class="text-xs text-text-muted uppercase font-semibold">Est. Turnaround</span>
                <p id="summary-timeline" class="text-xl font-black text-brand-primary mt-0.5">2 - 3 Weeks</p>
                <span class="text-[11px] text-text-muted block">Milestone Delivery</span>
              </div>
            </div>

            <div>
              <span class="text-xs text-text-muted uppercase font-semibold">Recommended Architecture</span>
              <div id="summary-stack-pills" class="flex flex-wrap gap-1.5 mt-1.5">
                <span class="text-[11px] font-mono text-brand-primary bg-surface-2 px-2.5 py-1 rounded border border-hairline">Astro</span>
                <span class="text-[11px] font-mono text-brand-primary bg-surface-2 px-2.5 py-1 rounded border border-hairline">React Islands</span>
                <span class="text-[11px] font-mono text-brand-primary bg-surface-2 px-2.5 py-1 rounded border border-hairline">TypeScript</span>
                <span class="text-[11px] font-mono text-brand-primary bg-surface-2 px-2.5 py-1 rounded border border-hairline">Tailwind v4</span>
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between">
                <span class="text-xs text-text-muted uppercase font-semibold">Active Add-ons</span>
                <span class="text-xs font-bold text-text-body"><span id="addon-count">1</span> Selected</span>
              </div>
              <ul id="summary-addons" class="text-xs text-text-body mt-1.5 space-y-1">
                <li class="flex items-center gap-1.5 text-text-primary">• Complete Technical SEO &amp; Schema</li>
              </ul>
            </div>
          </div>

          <!-- Included Value Guarantees -->
          <div class="p-3.5 rounded-xl bg-surface-2/60 border border-hairline mb-6 text-xs text-text-body space-y-1.5">
            <div class="flex items-center gap-2 text-[var(--color-success)] font-semibold">
              <span>✓</span> 100% Full Source Code &amp; Intellectual Property Ownership
            </div>
            <div class="flex items-center gap-2 text-[var(--color-success)] font-semibold">
              <span>✓</span> Sub-second Mobile Performance Standard Guarantee
            </div>
            <div class="flex items-center gap-2 text-[var(--color-success)] font-semibold">
              <span>✓</span> Direct WhatsApp Access with Technical Project Lead
            </div>
          </div>

          <!-- Primary WhatsApp CTA -->
          <a id="estimator-whatsapp-btn"
             href={`https://wa.me/${phone}?text=Hi%20SKYON%20IT%20SOLUTIONS%2C%20I%20configured%20a%20project%20scope.`}
             target="_blank"
             rel="noopener noreferrer"
             class="w-full flex items-center justify-center gap-2 sm:gap-3 py-3.5 sm:py-4 px-3 sm:px-6 rounded-xl bg-whatsapp hover:bg-whatsapp/90 text-white font-extrabold text-xs sm:text-sm shadow-xl shadow-black/40 hover:-translate-y-0.5 transition-all text-center min-h-[44px]">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" class="flex-shrink-0">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2Z" />
            </svg>
            <span>Send Scope for Instant WhatsApp Quote</span>
            <span>&rarr;</span>
          </a>

          <!-- Secondary Actions: Copy Brief + Strategy Call -->
          <div class="grid grid-cols-2 gap-2 mt-3">
            <button type="button"
                    id="copy-brief-btn"
                    class="py-2.5 px-3 rounded-lg bg-surface-2 hover:bg-surface-2/80 border border-hairline text-text-primary text-xs font-semibold flex items-center justify-center gap-1.5 transition-all cursor-pointer">
              <span id="copy-icon">📋</span>
              <span id="copy-text">Copy Scope</span>
            </button>
            <a href="/contact"
               class="py-2.5 px-3 rounded-lg bg-surface-2 hover:bg-surface-2/80 border border-hairline text-text-primary text-xs font-semibold flex items-center justify-center gap-1.5 transition-all">
              <span>📞</span>
              <span>Formal RFP / Email</span>
            </a>
          </div>

          <p class="text-[11px] text-center text-text-muted mt-4">
            Zero commitment • Direct WhatsApp consultation • Strict NDA confidentiality
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Base Option Buttons */
  .estimator-option {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 16px 18px;
    border-radius: 14px;
    background: var(--color-surface-2);
    border: 1.5px solid var(--color-hairline);
    color: var(--color-text-primary);
    cursor: pointer;
    text-align: left;
    user-select: none;
    transition: all 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .estimator-option:hover {
    background: rgba(92, 194, 255, 0.08);
    border-color: var(--color-brand-primary);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .estimator-option:active {
    transform: translateY(0) scale(0.98);
  }

  .estimator-option:focus-visible {
    outline: none;
    border-color: var(--color-brand-primary);
    box-shadow: 0 0 0 3px rgba(92, 194, 255, 0.35);
  }

  .estimator-option.is-active {
    background: rgba(92, 194, 255, 0.12);
    border-color: var(--color-brand-primary);
    box-shadow: 0 0 24px rgba(92, 194, 255, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  /* Radio Indicator inside Option */
  .radio-indicator {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid var(--color-hairline);
    display: grid;
    place-items: center;
    pointer-events: none;
    transition: all 0.2s ease;
  }

  .estimator-option.is-active .radio-indicator {
    border-color: var(--color-brand-primary);
    background: rgba(92, 194, 255, 0.25);
    box-shadow: 0 0 10px rgba(92, 194, 255, 0.4);
  }

  .estimator-option.is-active .radio-indicator::after {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-brand-primary);
    box-shadow: 0 0 8px var(--color-brand-primary);
  }

  .estimator-option-icon {
    font-size: 24px;
    line-height: 1;
    pointer-events: none;
  }

  .estimator-option-label {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: 4px;
    pointer-events: none;
  }

  .estimator-option-desc {
    font-size: 11px;
    color: var(--color-text-muted);
    margin-top: 3px;
    line-height: 1.35;
    pointer-events: none;
  }

  /* Addon Pills */
  .estimator-pill {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--color-surface-2);
    border: 1.5px solid var(--color-hairline);
    color: var(--color-text-body);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    text-align: left;
  }

  .estimator-pill:hover {
    background: rgba(92, 194, 255, 0.08);
    border-color: var(--color-brand-primary);
    transform: translateY(-1px);
  }

  .estimator-pill:active {
    transform: scale(0.98);
  }

  .estimator-pill:focus-visible {
    outline: none;
    border-color: var(--color-success);
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.3);
  }

  .estimator-pill.is-active {
    background: rgba(34, 197, 94, 0.14);
    border-color: var(--color-success);
    color: var(--color-text-primary);
    box-shadow: 0 0 18px rgba(34, 197, 94, 0.2);
  }

  .estimator-pill.is-fasttrack.is-active {
    background: rgba(92, 194, 255, 0.16);
    border-color: var(--color-brand-primary);
    box-shadow: 0 0 20px rgba(92, 194, 255, 0.28);
  }

  .estimator-pill-checkbox {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1.5px solid var(--color-hairline);
    flex-shrink: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    transition: all 0.15s ease;
  }

  .estimator-pill.is-active .estimator-pill-checkbox {
    background: var(--color-success);
    border-color: var(--color-success);
    box-shadow: 0 0 10px rgba(34, 197, 94, 0.4);
  }

  .estimator-pill.is-fasttrack.is-active .estimator-pill-checkbox {
    background: var(--color-brand-primary);
    border-color: var(--color-brand-primary);
    box-shadow: 0 0 12px rgba(92, 194, 255, 0.6);
  }

  .estimator-pill.is-active .estimator-pill-checkbox::after {
    content: "✓";
    font-size: 11px;
    font-weight: 900;
    color: var(--color-canvas);
  }

  .estimator-pill-text {
    pointer-events: none;
  }
</style>

<script>
  function initEstimator() {
    const container = document.getElementById('estimator');
    if (!container) return;

    // Prevent duplicate event binding on page re-hydration
    if (container.hasAttribute('data-ready')) {
      return;
    }
    container.setAttribute('data-ready', 'true');

    const phone = container.getAttribute('data-phone') || '917014865202';

    const serviceButtons = container.querySelectorAll('#service-options .estimator-option');
    const scaleButtons = container.querySelectorAll('#scale-options .estimator-option');
    const addonButtons = container.querySelectorAll('#addon-options .estimator-pill');
    const nameInput = document.getElementById('client-name-input') as HTMLInputElement | null;

    const summaryService = document.getElementById('summary-service');
    const summaryScale = document.getElementById('summary-scale');
    const summaryTier = document.getElementById('summary-tier');
    const summaryTimeline = document.getElementById('summary-timeline');
    const summaryStackPills = document.getElementById('summary-stack-pills');
    const summaryAddons = document.getElementById('summary-addons');
    const addonCountEl = document.getElementById('addon-count');
    const fasttrackBadge = document.getElementById('fasttrack-badge');
    const whatsappBtn = document.getElementById('estimator-whatsapp-btn');
    const copyBriefBtn = document.getElementById('copy-brief-btn');
    const copyText = document.getElementById('copy-text');
    const copyIcon = document.getElementById('copy-icon');

    if (!summaryService || !whatsappBtn) return;

    let selectedService = "Web Application / SaaS";
    let selectedScale = "Starter MVP";
    let selectedTier = "Essential Launch Tier";
    let selectedStack = "Astro + React Islands + TypeScript + Tailwind v4";
    let currentServiceEl = serviceButtons[0] as HTMLElement | undefined;
    let selectedAddons: string[] = ["Complete Technical SEO & Schema"];
    let clientName = "";

    function calculateTimeline(): string {
      if (!currentServiceEl) return "2 - 3 Weeks";
      let time = "2 - 3 Weeks";
      if (selectedScale === "Starter MVP") {
        time = currentServiceEl.getAttribute('data-time-starter') || "1 - 2 Weeks";
      } else if (selectedScale === "Growth Scale") {
        time = currentServiceEl.getAttribute('data-time-growth') || "3 - 5 Weeks";
      } else if (selectedScale === "Enterprise") {
        time = currentServiceEl.getAttribute('data-time-enterprise') || "6 - 8 Weeks";
      }

      // Check if Fast-track is toggled
      const hasFastTrack = selectedAddons.some(a => a.includes('Fast-Track'));
      if (hasFastTrack && fasttrackBadge) {
        fasttrackBadge.classList.remove('hidden');
        return time + " (⚡ Accelerated)";
      } else if (fasttrackBadge) {
        fasttrackBadge.classList.add('hidden');
        return time;
      }
      return time;
    }

    function generateBriefText(): string {
      const timeline = calculateTimeline();
      const lines: string[] = [];

      if (clientName && clientName.trim().length > 0) {
        lines.push(`Hi SKYON IT SOLUTIONS, I'm ${clientName.trim()}. Here is our configured project scope:`);
      } else {
        lines.push(`Hi SKYON IT SOLUTIONS, I configured a project scope on your website:`);
      }

      lines.push(``);
      lines.push(`• Service Category: ${selectedService}`);
      lines.push(`• Scale / Tier: ${selectedScale} (${selectedTier})`);
      lines.push(`• Target Timeline: ${timeline}`);
      lines.push(`• Tech Architecture: ${selectedStack}`);
      lines.push(`• Add-ons & Integrations: ${selectedAddons.length > 0 ? selectedAddons.join(', ') : 'None'}`);
      lines.push(``);
      lines.push(`Could you please share your availability, detailed proposal, and quote for this scope?`);

      return lines.join('\n');
    }

    function updateSummary() {
      const timeline = calculateTimeline();

      if (summaryService) summaryService.textContent = selectedService;
      if (summaryScale) summaryScale.textContent = selectedScale;
      if (summaryTier) summaryTier.textContent = selectedTier;
      if (summaryTimeline) summaryTimeline.textContent = timeline;
      if (addonCountEl) addonCountEl.textContent = selectedAddons.length.toString();

      // Render stack pills
      if (summaryStackPills) {
        const stackParts = selectedStack.split('+').map(s => s.trim());
        summaryStackPills.innerHTML = stackParts
          .map(p => `<span class="text-[11px] font-mono text-brand-primary bg-surface-2 px-2.5 py-1 rounded border border-hairline">${p}</span>`)
          .join('');
      }

      // Render addons
      if (summaryAddons) {
        if (selectedAddons.length === 0) {
          summaryAddons.innerHTML = '<li class="text-text-muted italic">None selected</li>';
        } else {
          summaryAddons.innerHTML = selectedAddons
            .map((a) => `<li class="flex items-center gap-1.5 text-text-primary">• ${a}</li>`)
            .join('');
        }
      }

      // Generate WhatsApp Link
      const msg = generateBriefText();
      const url = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
      if (whatsappBtn) {
        whatsappBtn.setAttribute('href', url);
      }
    }

    // Name Input Event
    if (nameInput) {
      nameInput.addEventListener('input', () => {
        clientName = nameInput.value;
        updateSummary();
      });
    }

    // Step 1: Service Selection
    serviceButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        serviceButtons.forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');
        currentServiceEl = btn as HTMLElement;
        selectedService = btn.getAttribute('data-service') || '';
        selectedStack = btn.getAttribute('data-stack') || '';
        updateSummary();
      });
    });

    // Step 2: Scale Selection
    scaleButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        scaleButtons.forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');
        selectedScale = btn.getAttribute('data-scale') || '';
        selectedTier = btn.getAttribute('data-tier') || '';
        updateSummary();
      });
    });

    // Step 3: Addons Toggle
    addonButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const isActive = btn.classList.toggle('is-active');
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        const addon = btn.getAttribute('data-addon') || '';
        if (isActive) {
          if (!selectedAddons.includes(addon)) selectedAddons.push(addon);
        } else {
          selectedAddons = selectedAddons.filter((a) => a !== addon);
        }
        updateSummary();
      });
    });

    // Copy to clipboard
    if (copyBriefBtn && copyText && copyIcon) {
      copyBriefBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        const brief = generateBriefText();
        try {
          await navigator.clipboard.writeText(brief);
          copyText.textContent = "Copied Scope!";
          copyIcon.textContent = "✓";
          copyBriefBtn.classList.add('text-brand-primary');
          setTimeout(() => {
            copyText.textContent = "Copy Scope";
            copyIcon.textContent = "📋";
            copyBriefBtn.classList.remove('text-brand-primary');
          }, 2000);
        } catch (err) {
          console.error("Clipboard write failed", err);
        }
      });
    }

    // Run initial calculation
    updateSummary();
  }

  // Safe multi-lifecycle execution
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEstimator);
  } else {
    initEstimator();
  }
  document.addEventListener('astro:page-load', initEstimator);
</script>
