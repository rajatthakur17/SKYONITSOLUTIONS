---
import { Image } from 'astro:assets';
import earthNetworkBackground from '../../../backgoundim/Global Connectivity Earth Network.png';
import { SERVICES } from '../../data/services';

interface Props {
  isPage?: boolean;
}

const { isPage = false } = Astro.props;
---
<section id="services" class={`services-section backdrop-02-services border-b border-hairline px-4 md:px-8 ${isPage ? 'pt-28 md:pt-36 pb-16 md:pb-24' : 'py-12 md:py-24'}`}>
  <Image
    src={earthNetworkBackground}
    alt=""
    aria-hidden="true"
    class="services-background"
    loading={isPage ? 'eager' : 'lazy'}
  />
  <div class="services-content max-w-[72rem] mx-auto">
    <div class="mb-8 md:mb-16">
      {isPage ? (
        <h1 class="text-3xl md:text-5xl font-bold text-text-primary mb-4 tracking-tight">IT Services &amp; Capabilities</h1>
      ) : (
        <h2 class="text-3xl md:text-5xl font-bold text-text-primary mb-4 tracking-tight">IT Services &amp; Capabilities</h2>
      )}
      <p class="text-lg text-text-body max-w-[42rem]">
        Software and web development, UI/UX, cloud, AI and automation, consulting, SEO, and digital growth for Indian and international businesses.
      </p>
      <p class="mt-3 max-w-[42rem] text-sm text-text-muted md:hidden">
        Supporting clinics, real estate, jewellery makers, SMEs/MSMEs, startups, enterprises, and international teams.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {SERVICES.map((service) => (
        <a href={`/services/${service.slug}`} class="motion-click group block bg-surface-1/95 backdrop-blur-xs border border-hairline rounded-lg p-6 hover:border-brand-primary hover:shadow-md transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-0.5 bg-brand-primary/10 text-brand-primary text-[11px] font-bold tracking-widest uppercase rounded">{service.badge}</span>
              <div class="w-8 h-8 rounded-full bg-canvas border border-hairline flex items-center justify-center text-text-primary group-hover:text-brand-primary transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={service.icon} />
                </svg>
              </div>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-2 group-hover:text-brand-primary transition-colors">{service.title}</h3>
            <p class="text-text-body text-sm leading-relaxed mb-4">{service.description}</p>
            {service.keyMetrics && service.keyMetrics.length > 0 && (
              <div class="mb-4">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-canvas border border-hairline font-mono text-xs text-text-primary">
                  <span class="text-brand-primary font-extrabold">{service.keyMetrics[0].value}</span>
                  <span class="text-text-muted text-[11px] font-sans">{service.keyMetrics[0].label}</span>
                </span>
              </div>
            )}
          </div>
          <div class="text-xs font-semibold text-brand-primary group-hover:text-brand-hover flex items-center gap-1 pt-3 border-t border-hairline">
            View Service Scope &rarr;
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .services-section::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--overlay-services);
    content: '';
    pointer-events: none;
  }

  .services-background {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.85;
    pointer-events: none;
  }

  .services-content {
    position: relative;
    z-index: 1;
  }

  @media (min-width: 48rem) {
    .services-background {
      object-position: 65% center;
    }
  }
</style>
