---
const services = [
  {
    id: 'build',
    title: 'Website Development',
    category: 'BUILD',
    description: 'Accessible, secure, and custom-designed websites built with clear structure, usability, and business goals in mind.',
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  },
  {
    id: 'get-found',
    title: 'Search Engine Optimization',
    category: 'GET FOUND',
    description: 'Technical and content-driven SEO strategies focused on technical SEO, on-page optimization, and search visibility.',
    icon: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  },
  {
    id: 'grow-marketing',
    title: 'Digital Marketing',
    category: 'GROW',
    description: 'Data-driven marketing campaigns designed to reach relevant audiences and support your marketing goals.',
    icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
  },
  {
    id: 'grow-social',
    title: 'Social Media Management',
    category: 'GROW',
    description: 'Strategic content creation and community management to build your brand online.',
    icon: 'M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z',
  }
];
---
<section id="services" class="py-24 px-4 md:px-8 border-b border-hairline">
  <div class="max-w-[72rem] mx-auto">
    <div class="mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-text-primary mb-4 tracking-tight">Our Services</h2>
      <p class="text-lg text-text-body max-w-[42rem]">
        We provide the essential digital tools and channels to establish and strengthen your online presence.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {services.map((service) => (
        <div class="bg-surface-1 border border-hairline rounded-lg p-8">
          <div class="flex items-center justify-between mb-6">
            <span class="text-xs font-bold text-brand-accent tracking-widest uppercase">{service.category}</span>
            <div class="w-10 h-10 rounded-full bg-canvas border border-hairline flex items-center justify-center text-text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={service.icon} />
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-bold text-text-primary mb-3">{service.title}</h3>
          <p class="text-text-body">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
