---
const testimonials = [
  {
    position: 'left',
    quote: "SKYON built our real estate platform with speed and exceptional precision. The website loads instantly on mobile, and property inquiries started flowing in from week one.",
    author: "R4Realty Leadership",
    role: "Property Development & Brokerage",
    industry: "Real Estate",
    rating: 5,
  },
  {
    position: 'center',
    quote: "Unlike agencies that just hand over templates, SKYON engineered a complete digital presence with clear patient inquiry workflows. Their technical clarity and WhatsApp support are outstanding.",
    author: "Clinical Operations Director",
    role: "Healthcare Practice",
    industry: "Healthcare & Clinics",
    rating: 5,
  },
  {
    position: 'right',
    quote: "They developed our online biodata web platform using modern Astro and React islands. The application handles high daily user traffic effortlessly with zero downtime and sub-second speeds.",
    author: "Product Strategy Team",
    role: "Consumer Digital Utility",
    industry: "Digital SaaS & Web Apps",
    rating: 5,
  }
];
---

<section id="testimonials" class="testimonials-section py-20 md:py-28 px-4 md:px-8 border-b border-hairline overflow-hidden">
  <div class="relative z-1 max-w-[76rem] mx-auto">
    <!-- Header -->
    <div class="text-center max-w-[44rem] mx-auto mb-10 md:mb-14">
      <span class="inline-block px-3 py-1 bg-surface-2/60 backdrop-blur-sm text-brand-primary border border-hairline text-xs font-bold tracking-widest uppercase rounded-full mb-3 shadow-xs">
        Client Feedback &amp; Trust
      </span>
      <h2 class="text-3xl md:text-5xl font-extrabold text-text-primary tracking-tight leading-tight mb-4 drop-shadow-sm">
        Trusted by Growing Businesses &amp; Industry Leaders.
      </h2>
      <p class="text-base md:text-lg text-text-body leading-relaxed">
        Real experiences from organizations that partnered with SKYON for high-performance software engineering, automation, and digital growth.
      </p>
    </div>

    <!-- REVIEWS ROW -->
    <div class="reviews-wrapper" id="reviews-track" tabindex="0" aria-label="Client testimonials carousel">
      {testimonials.map((item) => (
        <article class={`review-card ${item.position}`}>
          <div class="flex flex-col justify-between h-full">
            <div>
              <!-- Stars & Verification Badge -->
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-1 text-[var(--color-warning)]" aria-label="5 out of 5 stars">
                  {[...Array(item.rating)].map(() => (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-surface-2/80 text-brand-primary border border-hairline">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-primary shadow-[0_0_8px_var(--color-brand-primary)]"></span>
                  Verified
                </span>
              </div>

              <!-- Quote Copy -->
              <blockquote class="text-text-primary text-base leading-relaxed mb-6 font-medium">
                &ldquo;{item.quote}&rdquo;
              </blockquote>
            </div>

            <!-- Author / Company Info -->
            <div class="pt-4 border-t border-hairline flex items-center justify-between">
              <div>
                <div class="font-bold text-text-primary text-sm tracking-tight">{item.author}</div>
                <div class="text-xs text-text-muted mt-0.5">{item.role}</div>
              </div>
              <div class="text-right">
                <span class="inline-block text-[11px] font-mono font-medium text-brand-primary bg-surface-2/80 px-2 py-0.5 rounded border border-hairline">
                  {item.industry}
                </span>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Scroll hint for touch / smaller screens -->
    <div class="flex items-center justify-center gap-2 mt-4 text-xs text-text-muted lg:hidden" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
      <span>Scroll side-to-side to view reviews</span>
    </div>

    <!-- Bottom Reassurance Strip -->
    <div class="mt-12 pt-8 border-t border-hairline text-center">
      <p class="text-sm text-text-body flex items-center justify-center gap-2 flex-wrap">
        <span>Verified delivery for clients across India &amp; global markets.</span>
        <span aria-hidden="true" class="text-brand-primary">&bull;</span>
        <a href="/work" class="text-brand-primary font-semibold hover:text-brand-hover underline underline-offset-4 transition-colors">
          Explore case studies and live platforms &rarr;
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--color-canvas);
    background-image:
      radial-gradient(ellipse at 50% 10%, rgba(92, 194, 255, 0.12) 0%, transparent 60%),
      radial-gradient(circle at 85% 85%, rgba(92, 194, 255, 0.05) 0%, transparent 50%),
      linear-gradient(180deg, var(--color-surface-1) 0%, var(--color-canvas) 100%);
  }

  /* ==============================
     REVIEWS ROW
  ============================== */

  .reviews-wrapper {
    display: flex;
    align-items: center;
    gap: 28px;
    width: 100%;
    overflow-x: auto;
    overflow-y: visible;
    padding: 35px 10px 45px;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    perspective: 1400px;
  }

  @media (min-width: 951px) {
    .reviews-wrapper {
      justify-content: center;
    }
  }

  .reviews-wrapper::-webkit-scrollbar {
    display: none;
  }

  /* ==============================
     REVIEW CARD
  ============================== */

  .review-card {
    position: relative;
    flex: 0 0 330px;
    min-height: 290px;
    padding: 30px;
    border-radius: 22px;
    background: var(--color-surface-1);
    border: 1px solid var(--color-hairline);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow:
      0 25px 60px rgba(0, 0, 0, 0.35),
      inset 0 1px rgba(255, 255, 255, 0.06);
    color: var(--color-text-primary);
    scroll-snap-align: center;
    transform-style: preserve-3d;
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.45s ease,
      border-color 0.45s ease;
    animation: reviewFloat 5s ease-in-out infinite;
  }

  /* ==============================
     IMAGE-LIKE COMPOSITION
  ============================== */

  /* Left */
  .review-card.left {
    transform: translateY(15px) scale(0.92);
    animation-delay: -1.5s;
  }

  /* Center */
  .review-card.center {
    flex-basis: 390px;
    min-height: 350px;
    transform: translateY(-10px) scale(1.04);
    z-index: 3;
  }

  /* Right */
  .review-card.right {
    transform: translateY(15px) scale(0.92);
    animation-delay: -3s;
  }

  /* ==============================
     FLOATING
  ============================== */

  @keyframes reviewFloat {
    0%, 100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -9px;
    }
  }

  /* ==============================
     HOVER
  ============================== */

  .review-card:hover {
    animation-play-state: paused;
    transform: translateY(-15px) scale(1.03);
    border-color: var(--color-brand-primary);
    box-shadow:
      0 35px 85px rgba(0, 0, 0, 0.5),
      0 0 35px rgba(92, 194, 255, 0.2),
      inset 0 1px rgba(255, 255, 255, 0.1);
  }

  .review-card.center:hover {
    transform: translateY(-20px) scale(1.07);
  }

  /* ==============================
     LIGHT SWEEP
  ============================== */

  .review-card::after {
    content: "";
    position: absolute;
    top: 0;
    left: -130%;
    width: 55%;
    height: 100%;
    border-radius: 22px;
    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.18),
        transparent
      );
    transform: skewX(-20deg);
    transition: left 0.8s ease;
    pointer-events: none;
  }

  .review-card:hover::after {
    left: 150%;
  }

  /* ==============================
     MOBILE
  ============================== */

  @media (max-width: 950px) {
    .reviews-wrapper {
      justify-content: flex-start;
      gap: 20px;
      padding-left: 20px;
      padding-right: 20px;
      scroll-snap-type: x mandatory;
    }

    .review-card,
    .review-card.left,
    .review-card.right,
    .review-card.center {
      flex: 0 0 320px;
      min-height: 290px;
      transform: none;
      scroll-snap-align: center;
    }

    .review-card.center {
      flex-basis: 340px;
    }

    .review-card:hover,
    .review-card.center:hover {
      transform: translateY(-10px) scale(1.02);
    }
  }

  /* ==============================
     SMALL MOBILE
  ============================== */

  @media (max-width: 500px) {
    .reviews-wrapper {
      gap: 16px;
      padding-left: 14px;
      padding-right: 14px;
    }

    .review-card,
    .review-card.left,
    .review-card.right,
    .review-card.center {
      flex: 0 0 86vw;
      min-height: 275px;
      padding: 24px;
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .review-card {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
