---
// FloatingReview.astro — Floating client review & rating trust badge
const initialQuotes = [
  {
    author: "R4Realty Leadership",
    role: "Property Development",
    rating: 5,
    quote: "SKYON built our platform with speed & precision. Property inquiries started week one."
  },
  {
    author: "Clinical Operations Director",
    role: "Healthcare Practice",
    rating: 5,
    quote: "Clear patient inquiry workflows. Technical clarity and WhatsApp support are outstanding."
  },
  {
    author: "Product Strategy Team",
    role: "Digital SaaS & Web Apps",
    rating: 5,
    quote: "Modern Astro & React islands. Handles high daily traffic with zero downtime."
  }
];
---

<div
  id="floating-review-widget"
  class="floating-review-container"
  role="region"
  aria-label="Client reviews and trust badge"
>
  <!-- Full Expanded Card (Hidden by default on initial page load) -->
  <div
    id="floating-review-card"
    class="floating-review-card hidden"
    aria-hidden="true"
  >
    <!-- Top Header -->
    <div class="flex items-center justify-between gap-2 pb-2.5 mb-2 border-b border-hairline">
      <div class="flex items-center gap-1.5">
        <div class="flex items-center text-amber-400 text-xs tracking-tight" aria-label="5 star rating">
          ★★★★★
        </div>
        <span class="text-xs font-bold text-text-primary">5.0</span>
        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          <span class="w-1 h-1 rounded-full bg-emerald-400"></span>
          Verified
        </span>
      </div>

      <button
        type="button"
        id="floating-review-minimize-btn"
        class="w-7 h-7 min-w-[28px] min-h-[28px] flex items-center justify-center rounded-lg text-text-muted hover:text-text-primary hover:bg-surface-2 transition-colors text-xs leading-none cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
        aria-label="Collapse review widget"
        title="Collapse reviews"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
    </div>

    <!-- Rotating Quote Body -->
    <div class="relative min-h-[54px] flex flex-col justify-center my-0.5">
      <div id="floating-review-content" class="transition-opacity duration-300 opacity-100">
        <p id="floating-review-quote" class="text-xs text-text-primary leading-snug line-clamp-2 italic font-medium">
          &ldquo;{initialQuotes[0].quote}&rdquo;
        </p>
        <div class="flex items-center justify-between mt-1.5 text-[11px] text-text-muted">
          <span id="floating-review-author" class="font-semibold text-text-primary truncate max-w-[130px]">
            {initialQuotes[0].author}
          </span>
          <span id="floating-review-role" class="truncate max-w-[110px] text-brand-primary text-[10px] font-mono">
            {initialQuotes[0].role}
          </span>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center gap-1.5 pt-2.5 mt-2 border-t border-hairline/80">
      <a
        href="/#testimonials"
        id="floating-review-read-btn"
        class="flex-1 min-h-[30px] flex items-center justify-center gap-1 bg-surface-2 hover:bg-surface-2/80 border border-hairline hover:border-brand-primary text-text-primary hover:text-brand-primary text-[11px] font-semibold rounded-lg px-2 py-1 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
      >
        <span>Read Reviews</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-brand-primary" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>

      <button
        type="button"
        id="floating-review-write-btn"
        data-open-feedback="true"
        class="open-feedback-trigger flex-1 min-h-[30px] flex items-center justify-center gap-1 bg-brand-primary/10 hover:bg-brand-primary/20 border border-brand-primary/30 hover:border-brand-primary/60 text-brand-primary text-[11px] font-semibold rounded-lg px-2 py-1 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
      >
        <span class="text-amber-400">★</span>
        <span>+ Review</span>
      </button>
    </div>
  </div>

  <!-- Collapsed Mini Pill Button (Visible by default) -->
  <button
    type="button"
    id="floating-review-pill-btn"
    class="floating-review-pill"
    aria-expanded="false"
    aria-controls="floating-review-card"
    aria-label="Expand client reviews: rated 5.0 out of 5 stars"
    title="View client reviews & ratings"
  >
    <span class="text-amber-400 text-xs" aria-hidden="true">★</span>
    <span class="font-bold text-text-primary text-xs">5.0</span>
    <span class="text-text-muted text-[11px] font-medium hidden sm:inline">• Reviews</span>
  </button>
</div>

<script is:inline define:vars={{ defaultQuotes: initialQuotes }}>
  (function() {
    function initFloatingReview() {
      var widget = document.getElementById('floating-review-widget');
      var card = document.getElementById('floating-review-card');
      var pill = document.getElementById('floating-review-pill-btn');
      var minimizeBtn = document.getElementById('floating-review-minimize-btn');
      var readBtn = document.getElementById('floating-review-read-btn');
      var writeBtn = document.getElementById('floating-review-write-btn');

      var quoteEl = document.getElementById('floating-review-quote');
      var authorEl = document.getElementById('floating-review-author');
      var roleEl = document.getElementById('floating-review-role');
      var contentEl = document.getElementById('floating-review-content');

      if (!widget || !card || !pill) return;

      var quotesList = [];

      function refreshQuotesList() {
        quotesList = Array.isArray(defaultQuotes) ? defaultQuotes.slice() : [];
        try {
          var rawStored = localStorage.getItem('skyon_client_reviews');
          if (rawStored) {
            var userReviews = JSON.parse(rawStored);
            if (Array.isArray(userReviews) && userReviews.length > 0) {
              userReviews.slice(0, 3).forEach(function(ur) {
                quotesList.unshift({
                  author: ur.author || 'Verified Client',
                  role: ur.role || ur.category || 'Client Review',
                  rating: ur.rating || 5,
                  quote: ur.quote || ur.comment || ''
                });
              });
            }
          }
        } catch (err) {}
      }

      refreshQuotesList();

      var currentIndex = 0;
      var rotationTimer = null;

      function renderCurrentQuote() {
        if (!quotesList.length || !quoteEl || !authorEl || !roleEl || !contentEl) return;
        var item = quotesList[currentIndex % quotesList.length];

        contentEl.classList.remove('opacity-100');
        contentEl.classList.add('opacity-0');

        setTimeout(function() {
          quoteEl.innerHTML = '&ldquo;' + (item.quote || '') + '&rdquo;';
          authorEl.textContent = item.author || 'Verified Client';
          roleEl.textContent = item.role || 'Client Review';

          contentEl.classList.remove('opacity-0');
          contentEl.classList.add('opacity-100');
        }, 180);
      }

      function startRotation() {
        stopRotation();
        rotationTimer = setInterval(function() {
          currentIndex = (currentIndex + 1) % quotesList.length;
          renderCurrentQuote();
        }, 5500);
      }

      function stopRotation() {
        if (rotationTimer) {
          clearInterval(rotationTimer);
          rotationTimer = null;
        }
      }

      // Minimize / Collapse
      function minimizeWidget(restoreFocus) {
        card.classList.add('hidden');
        card.setAttribute('aria-hidden', 'true');
        pill.classList.remove('hidden');
        pill.setAttribute('aria-expanded', 'false');
        stopRotation();
        if (restoreFocus && pill) {
          pill.focus();
        }
      }

      // Expand to show card
      function expandWidget() {
        pill.classList.add('hidden');
        pill.setAttribute('aria-expanded', 'true');
        card.classList.remove('hidden');
        card.setAttribute('aria-hidden', 'false');
        renderCurrentQuote();
        startRotation();
        if (minimizeBtn) {
          minimizeBtn.focus();
        }
      }

      if (minimizeBtn) {
        minimizeBtn.addEventListener('click', function() {
          minimizeWidget(true);
        });
      }

      if (pill) {
        pill.addEventListener('click', expandWidget);
      }

      // Allow Escape key to collapse when focused inside card
      card.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' || e.key === 'Esc') {
          e.preventDefault();
          minimizeWidget(true);
        }
      });

      // Handle Read Reviews smooth scroll
      if (readBtn) {
        readBtn.addEventListener('click', function(e) {
          var isHome = window.location.pathname === '/' || window.location.pathname === '';
          var testimonialsEl = document.getElementById('testimonials');
          if (isHome && testimonialsEl) {
            e.preventDefault();
            testimonialsEl.scrollIntoView({ behavior: 'smooth' });
          }
        });
      }

      // Handle Write Review button
      if (writeBtn) {
        writeBtn.addEventListener('click', function(e) {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('skyon:open-feedback'));
        });
      }

      // Listen for newly posted review
      window.addEventListener('skyon:review-posted', function(e) {
        var newRev = e.detail;
        if (!newRev) return;

        quotesList.unshift({
          author: newRev.author || 'Verified Client',
          role: newRev.role || newRev.category || 'Client Review',
          rating: newRev.rating || 5,
          quote: newRev.quote || newRev.comment || ''
        });

        currentIndex = 0;
        expandWidget();
        renderCurrentQuote();
      });

      // Listen for reviews updated / deleted
      window.addEventListener('skyon:reviews-updated', function() {
        refreshQuotesList();
        currentIndex = 0;
        renderCurrentQuote();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFloatingReview);
    } else {
      initFloatingReview();
    }
  })();
</script>

<style>
  .floating-review-container {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 40;
    font-family: inherit;
  }

  /* Solid Opaque SKYON-Themed Card */
  .floating-review-card {
    position: relative;
    width: 295px;
    max-width: calc(100vw - 32px);
    background-color: var(--color-surface-1);
    border: 1px solid var(--color-hairline);
    border-radius: 16px;
    padding: 14px 16px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4), 0 2px 8px rgba(0, 0, 0, 0.2);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .floating-review-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand-primary);
    box-shadow: 0 20px 42px rgba(0, 0, 0, 0.5), 0 0 12px rgba(92, 194, 255, 0.15);
  }

  /* Light Theme Solid Opaque Card */
  :root[data-theme="light"] .floating-review-card,
  html[data-theme="light"] .floating-review-card {
    background-color: var(--color-surface-1);
    border-color: var(--color-hairline);
    box-shadow: 0 14px 32px rgba(7, 20, 31, 0.12), 0 2px 6px rgba(7, 20, 31, 0.06);
  }

  /* Solid Opaque Compact Review Pill */
  .floating-review-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background-color: var(--color-surface-1);
    color: var(--color-text-primary);
    border: 1px solid var(--color-hairline);
    border-radius: 9999px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35), 0 2px 6px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .floating-review-pill:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand-primary);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.4), 0 0 10px rgba(92, 194, 255, 0.2);
  }

  .floating-review-pill:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 2px;
  }

  :root[data-theme="light"] .floating-review-pill,
  html[data-theme="light"] .floating-review-pill {
    background-color: var(--color-surface-1);
    border-color: var(--color-hairline);
    box-shadow: 0 8px 20px rgba(7, 20, 31, 0.12);
  }

  @media (max-width: 640px) {
    .floating-review-container {
      bottom: 20px;
      left: 12px;
      max-width: calc(100vw - 84px);
    }

    .floating-review-card {
      width: 250px;
      max-width: calc(100vw - 88px);
      padding: 11px 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-review-card,
    .floating-review-pill {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
