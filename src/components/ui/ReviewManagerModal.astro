---
// ReviewManagerModal.astro — Moderation & Deletion Manager for Client Reviews
---

<div
  id="review-manager-overlay"
  class="review-manager-overlay fixed inset-0 z-50 bg-black/65 backdrop-blur-xs flex items-center justify-center p-4 transition-opacity duration-200 hidden opacity-0"
  role="dialog"
  aria-modal="true"
  aria-labelledby="manager-dialog-title"
>
  <div
    id="review-manager-card"
    class="w-full max-w-[36rem] bg-surface-1 border border-hairline rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[85vh] transition-transform duration-200 scale-95"
  >
    <!-- Header -->
    <div class="px-6 py-4 bg-surface-2 border-b border-hairline flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-brand-primary/10 border border-brand-primary/20 flex items-center justify-center text-brand-primary shrink-0">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <div>
          <h3 id="manager-dialog-title" class="text-sm font-bold text-text-primary">
            Review Moderation &amp; Storage Manager
          </h3>
          <p class="text-[11px] text-text-muted">
            Manage or delete reviews stored on this browser (<span id="stored-review-count">0</span> stored)
          </p>
        </div>
      </div>
      <button
        type="button"
        id="close-review-manager-btn"
        class="w-8 h-8 flex items-center justify-center rounded-lg text-text-muted hover:text-text-primary hover:bg-surface-1 transition-colors text-xl leading-none cursor-pointer"
        aria-label="Close manager dialog"
      >
        &times;
      </button>
    </div>

    <!-- Review List Body -->
    <div id="manager-reviews-list" class="p-5 overflow-y-auto space-y-3 flex-1 min-h-[160px]">
      <!-- Dynamically rendered review items -->
    </div>

    <!-- Empty State Template -->
    <div id="manager-empty-state" class="hidden p-8 text-center text-xs text-text-muted">
      <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-surface-2 flex items-center justify-center text-text-muted">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <p class="font-semibold text-text-primary mb-1">No Posted Reviews Found</p>
      <p>Only the default verified showcase testimonials are active.</p>
    </div>

    <!-- Footer Controls -->
    <div class="px-6 py-3 bg-surface-2 border-t border-hairline flex items-center justify-between gap-3 shrink-0">
      <button
        type="button"
        id="clear-all-reviews-btn"
        class="px-3 py-1.5 rounded-lg text-xs font-semibold text-red-400 hover:text-red-300 hover:bg-red-500/10 border border-red-500/20 transition-colors flex items-center gap-1.5 cursor-pointer"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        <span>Clear All Posted Reviews</span>
      </button>

      <button
        type="button"
        id="done-review-manager-btn"
        class="px-4 py-1.5 bg-brand-primary text-white hover:bg-brand-hover rounded-lg text-xs font-bold transition-colors cursor-pointer"
      >
        Done
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    function initReviewManager() {
      var overlay = document.getElementById('review-manager-overlay');
      var card = document.getElementById('review-manager-card');
      var closeBtn = document.getElementById('close-review-manager-btn');
      var doneBtn = document.getElementById('done-review-manager-btn');
      var clearAllBtn = document.getElementById('clear-all-reviews-btn');
      var listContainer = document.getElementById('manager-reviews-list');
      var emptyState = document.getElementById('manager-empty-state');
      var countEl = document.getElementById('stored-review-count');

      if (!overlay || !card) return;

      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function getStoredReviews() {
        try {
          var raw = localStorage.getItem('skyon_client_reviews');
          return raw ? JSON.parse(raw) : [];
        } catch (e) {
          return [];
        }
      }

      function saveStoredReviews(reviews) {
        try {
          localStorage.setItem('skyon_client_reviews', JSON.stringify(reviews));
        } catch (e) {}
        window.dispatchEvent(new CustomEvent('skyon:reviews-updated', { detail: reviews }));
      }

      function renderManagerList() {
        var reviews = getStoredReviews();
        if (countEl) countEl.textContent = String(reviews.length);

        if (!reviews || reviews.length === 0) {
          if (listContainer) listContainer.innerHTML = '';
          if (emptyState) emptyState.classList.remove('hidden');
          if (clearAllBtn) clearAllBtn.disabled = true;
          return;
        }

        if (emptyState) emptyState.classList.add('hidden');
        if (clearAllBtn) clearAllBtn.disabled = false;
        if (!listContainer) return;

        listContainer.innerHTML = '';

        reviews.forEach(function(rev, idx) {
          var itemEl = document.createElement('div');
          itemEl.className = 'p-3.5 bg-surface-2/60 border border-hairline rounded-xl flex items-start justify-between gap-3 text-xs';

          var stars = '★'.repeat(Math.max(1, Math.min(5, parseInt(rev.rating, 10) || 5)));
          var author = escapeHtml(rev.author || 'Verified Client');
          var role = escapeHtml(rev.role || rev.category || 'Review');
          var quote = escapeHtml(rev.quote || rev.comment || '');

          itemEl.innerHTML =
            '<div class="flex-1 min-w-0">' +
              '<div class="flex items-center gap-2 mb-1">' +
                '<span class="text-amber-400 font-bold tracking-tight">' + stars + '</span>' +
                '<span class="font-bold text-text-primary truncate">' + author + '</span>' +
                '<span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-surface-1 text-brand-primary border border-hairline truncate">' + role + '</span>' +
              '</div>' +
              '<p class="text-text-body text-[11px] leading-relaxed line-clamp-2 italic">&ldquo;' + quote + '&rdquo;</p>' +
            '</div>' +
            '<button type="button" data-delete-idx="' + idx + '" class="delete-single-review-btn px-2.5 py-1.5 rounded-lg text-[11px] font-semibold text-red-400 hover:text-red-300 hover:bg-red-500/10 border border-red-500/20 transition-colors shrink-0 cursor-pointer flex items-center gap-1" title="Delete this review">' +
              '<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">' +
                '<path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />' +
              '</svg>' +
              '<span>Delete</span>' +
            '</button>';

          listContainer.appendChild(itemEl);
        });

        // Attach delete listeners
        listContainer.querySelectorAll('.delete-single-review-btn').forEach(function(btn) {
          btn.addEventListener('click', function(e) {
            e.stopPropagation();
            var targetIdx = parseInt(btn.getAttribute('data-delete-idx') || '-1', 10);
            if (targetIdx >= 0) {
              var current = getStoredReviews();
              current.splice(targetIdx, 1);
              saveStoredReviews(current);
              renderManagerList();
            }
          });
        });
      }

      function openModal() {
        renderManagerList();
        overlay.classList.remove('hidden');
        requestAnimationFrame(function() {
          overlay.classList.remove('opacity-0');
          overlay.classList.add('opacity-100');
          card.classList.remove('scale-95');
          card.classList.add('scale-100');
        });
      }

      function closeModal() {
        overlay.classList.remove('opacity-100');
        overlay.classList.add('opacity-0');
        card.classList.remove('scale-100');
        card.classList.add('scale-95');
        setTimeout(function() {
          overlay.classList.add('hidden');
        }, 200);
      }

      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (doneBtn) doneBtn.addEventListener('click', closeModal);

      overlay.addEventListener('click', function(e) {
        if (e.target === overlay) closeModal();
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
          closeModal();
        }
      });

      // Clear all action
      if (clearAllBtn) {
        clearAllBtn.addEventListener('click', function() {
          if (confirm('Are you sure you want to delete all posted reviews from storage?')) {
            saveStoredReviews([]);
            renderManagerList();
          }
        });
      }

      // External trigger listeners
      document.querySelectorAll('#open-review-manager-btn, [data-open-review-manager="true"]').forEach(function(trigger) {
        trigger.addEventListener('click', openModal);
      });

      window.addEventListener('skyon:open-review-manager', openModal);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initReviewManager);
    } else {
      initReviewManager();
    }
  })();
</script>
