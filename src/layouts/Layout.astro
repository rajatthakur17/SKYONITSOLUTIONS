---
import '@fontsource-variable/manrope/index.css';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import MobileDrawer from '../components/layout/MobileDrawer.astro';
import Footer from '../components/layout/Footer.astro';
import MotionSystem from '../components/utils/MotionSystem.astro';
import ScrollProgress from '../components/ui/ScrollProgress.astro';
import CursorGlow from '../components/ui/CursorGlow.astro';
import WhatsAppFloat from '../components/ui/WhatsAppFloat.astro';
import FloatingReview from '../components/ui/FloatingReview.astro';
import { SITE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { 
  title = SITE.title,
  description = SITE.description,
  image = '/og-image.jpg',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE.url);

const isStagingNoindex = import.meta.env.PUBLIC_NOINDEX === 'true';
const robotsMeta = (noindex || isStagingNoindex) ? 'noindex, nofollow' : 'index, follow';

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": ["Organization", "ProfessionalService"],
  "name": "SKYON IT SOLUTIONS",
  "url": SITE.url,
  "logo": `${SITE.url}/favicon.svg`,
  "image": `${SITE.url}/og-image.jpg`,
  "email": SITE.email,
  "telephone": SITE.phone,
  "priceRange": "$$",
  "areaServed": ["IN", "US", "AE", "GB", "Global"],
  "sameAs": [
    SITE.linkedinUrl,
    SITE.instagramUrl
  ].filter(Boolean),
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": SITE.phone,
    "contactType": "customer support",
    "availableLanguage": ["English", "Hindi"]
  }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "SKYON IT SOLUTIONS",
  "url": SITE.url,
  "description": SITE.description
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={robotsMeta} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#07141F" />
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', '#EAF6FF');
          } else {
            document.documentElement.removeAttribute('data-theme');
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', '#07141F');
          }
        } catch (e) {
          document.documentElement.removeAttribute('data-theme');
        }
      })();
    </script>
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body class="antialiased min-h-screen flex flex-col overflow-x-clip w-full">
    <!-- Accessible Skip to Content -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 bg-button-fill text-button-text px-4 py-2 rounded shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary">
      Skip to content
    </a>
    
    <ScrollProgress />
    <CursorGlow />
    
    <Header />
    <MobileDrawer />
    
    <main id="main-content" class="flex-1 mt-16" tabindex="-1">
      <slot />
    </main>

    <Footer />
    <WhatsAppFloat />
    <FloatingReview />
    <MotionSystem />

    <script>
      function setupThemeToggles() {
        function updateAria(isLight: boolean) {
          const toggles = document.querySelectorAll<HTMLButtonElement>('.theme-toggle-btn');
          toggles.forEach((btn) => {
            btn.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme');
          });
        }

        function setTheme(theme: 'light' | 'dark') {
          const isLight = theme === 'light';
          if (isLight) {
            document.documentElement.setAttribute('data-theme', 'light');
          } else {
            document.documentElement.removeAttribute('data-theme');
          }

          try {
            localStorage.setItem('theme', theme);
          } catch (e) {}

          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) {
            meta.setAttribute('content', isLight ? '#EAF6FF' : '#07141F');
          }

          updateAria(isLight);
        }

        const isInitiallyLight = document.documentElement.getAttribute('data-theme') === 'light';
        updateAria(isInitiallyLight);

        const toggles = document.querySelectorAll<HTMLButtonElement>('.theme-toggle-btn');
        toggles.forEach((btn) => {
          btn.onclick = () => {
            const isCurrentlyLight = document.documentElement.getAttribute('data-theme') === 'light';
            setTheme(isCurrentlyLight ? 'dark' : 'light');
          };
        });
      }

      setupThemeToggles();
      document.addEventListener('astro:page-load', setupThemeToggles);
    </script>
  </body>
</html>
