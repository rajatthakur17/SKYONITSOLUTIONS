---
import Layout from '../../layouts/Layout.astro';
import { BLOG_POSTS, type BlogPost, getRelatedBlogPosts } from '../../data/blog';

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const title = `${post.title} | SKYON IT SOLUTIONS Blog`;
const description = post.summary;

const relatedPosts = getRelatedBlogPosts(post.slug, 2);
---

<Layout title={title} description={description}>
  <article class="backdrop-10-insights px-4 pt-28 pb-16 md:px-8 md:pt-36 border-b border-hairline">
    <div class="mx-auto max-w-[48rem]">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8 text-xs text-text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a href="/" class="hover:text-brand-hover transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-primary rounded">
              Home
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/blog" class="hover:text-brand-hover transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-primary rounded">
              Blog & Insights
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-text-primary font-semibold">
            {post.category}
          </li>
        </ol>
      </nav>

      <!-- Post Header -->
      <header class="border-b border-hairline pb-8">
        <div class="flex flex-wrap items-center gap-3 text-xs text-text-muted mb-4">
          <span class="rounded bg-brand-primary/15 text-brand-primary border border-brand-primary/30 px-2.5 py-0.5 font-bold uppercase tracking-wide">
            {post.category}
          </span>
          <span>{post.date}</span>
          <span>•</span>
          <span>{post.readTime}</span>
          <span>•</span>
          <span>By {post.author}</span>
        </div>

        <h1 class="text-3xl font-extrabold leading-tight text-text-primary md:text-4xl lg:text-5xl">
          {post.title}
        </h1>

        <p class="mt-5 text-base md:text-lg leading-relaxed text-text-body">
          {post.summary}
        </p>
      </header>

      <!-- Post Content Sections -->
      <div class="space-y-10 pt-8">
        {post.sections.map((section) => (
          <section class="space-y-4">
            <h2 class="text-xl md:text-2xl font-bold text-text-primary">
              {section.heading}
            </h2>
            {section.paragraphs.map((paragraph) => (
              <p class="leading-relaxed text-text-body text-sm md:text-base">
                {paragraph}
              </p>
            ))}
            {section.points && (
              <ul class="mt-4 space-y-2 border-l-2 border-brand-primary pl-5 text-text-body text-sm md:text-base">
                {section.points.map((point) => (
                  <li class="relative">
                    <span class="font-medium text-text-primary">•</span> {point}
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>

      <!-- Action Card -->
      <aside class="mt-12 rounded-xl border border-hairline bg-surface-1 p-6 md:p-8 shadow-sm">
        <h2 class="text-lg md:text-xl font-bold text-text-primary">
          Planning a related project?
        </h2>
        <p class="mt-2 text-xs md:text-sm text-text-body leading-relaxed">
          Explore SKYON IT SOLUTIONS services or discuss your specific system architecture and requirements directly with us.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href="/services"
            class="inline-flex min-h-[44px] items-center rounded-lg border border-hairline px-4 py-2 text-xs font-semibold text-text-primary hover:border-brand-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
          >
            Explore Services
          </a>
          <a
            href="/contact"
            class="inline-flex min-h-[44px] items-center rounded-lg bg-button-fill text-button-text px-5 py-2 text-xs font-bold hover:bg-button-hover transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
          >
            Contact SKYON &rarr;
          </a>
        </div>
      </aside>

      <!-- Related Articles -->
      {relatedPosts.length > 0 && (
        <div class="mt-16 pt-8 border-t border-hairline">
          <h2 class="text-xl font-bold text-text-primary mb-6">
            Related Guides & Articles
          </h2>
          <div class="grid gap-4 md:grid-cols-2">
            {relatedPosts.map((rel) => (
              <a
                href={`/blog/${rel.slug}`}
                class="group block rounded-lg border border-hairline bg-surface-1 p-5 transition-all hover:border-brand-primary/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
              >
                <div class="flex items-center justify-between text-[11px] text-text-muted mb-2">
                  <span class="font-bold uppercase text-brand-primary">{rel.category}</span>
                  <span>{rel.readTime}</span>
                </div>
                <h3 class="text-sm font-bold text-text-primary group-hover:text-brand-hover transition-colors line-clamp-2">
                  {rel.title}
                </h3>
                <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-brand-primary">
                  Read guide <span aria-hidden="true">&rarr;</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Back to Blog Link -->
      <div class="mt-10">
        <a
          href="/blog"
          class="inline-flex min-h-[44px] items-center gap-2 text-xs font-semibold text-text-muted hover:text-text-primary transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-primary rounded"
        >
          <span aria-hidden="true">&larr;</span> Back to Blog & Insights
        </a>
      </div>
    </div>
  </article>
</Layout>
