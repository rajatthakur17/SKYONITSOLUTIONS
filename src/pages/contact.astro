---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config/site';
import { BUDGET_RANGES } from '../data/budget';

const title = "Contact | SKYON IT SOLUTIONS";
const description = "Contact SKYON IT SOLUTIONS about software, web, cloud, AI, design, consulting, or digital growth services.";

const endpoint = SITE.formEndpoint;
const isConnected = endpoint.trim() !== '';
---

<Layout title={title} description={description}>
  <article class="backdrop-11-contact pt-24 sm:pt-32 pb-16 sm:pb-24 px-4 sm:px-6 md:px-8 max-w-[48rem] mx-auto">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-text-primary tracking-tight mb-4">Start a Project</h1>
    <p class="text-text-body text-base sm:text-lg mb-8">Tell us what you are looking to build, improve, or automate.</p>

    <div class="bg-surface-1 border border-hairline rounded-lg p-5 sm:p-6 md:p-10 mb-12 shadow-sm">
      <div class="mb-8 p-3.5 sm:p-4 bg-brand-primary/10 border border-brand-primary/30 text-text-body rounded-md font-medium text-xs sm:text-sm flex items-start sm:items-center gap-3">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-whatsapp shrink-0 mt-1 sm:mt-0"></span>
        <span>
          WhatsApp is our primary inquiry channel. <a href={SITE.whatsappUrl} target="_blank" rel="noopener noreferrer" class="underline text-brand-primary hover:text-brand-hover">Message SKYON directly</a> or use the form below.
        </span>
      </div>

      <div id="form-success" class="hidden mb-8 p-6 bg-[var(--color-success)]/10 border border-[var(--color-success)] text-[var(--color-success)] rounded-md" role="status" aria-live="polite" aria-atomic="true">
        <h3 class="font-bold text-lg mb-2">Message sent successfully!</h3>
        <p>Thank you for reaching out. We appreciate your inquiry.</p>
      </div>

      <div id="form-error" class="hidden mb-8 p-6 bg-error/10 border border-error text-error rounded-md" role="alert" aria-live="assertive" aria-atomic="true">
        <h3 class="font-bold text-lg mb-2">Something went wrong.</h3>
        <p>Please try again or use direct WhatsApp / email below.</p>
      </div>

      <form id="contact-form" action={endpoint} method="POST" class="space-y-6">
        <!-- Hidden Subject -->
        <input type="hidden" name="_subject" value="New Project Inquiry | SKYON IT SOLUTIONS" />

        <!-- Honeypot -->
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" aria-hidden="true" autocomplete="off" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="name" class="block font-medium text-text-primary">Name <span class="text-error">*</span></label>
            <input type="text" id="name" name="name" required class="w-full bg-surface-2 border border-border-strong rounded-md px-4 py-3 min-h-[44px] text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-primary" />
          </div>
          <div class="space-y-2">
            <label for="email" class="block font-medium text-text-primary">Email <span class="text-error">*</span></label>
            <input type="email" id="email" name="email" required class="w-full bg-surface-2 border border-border-strong rounded-md px-4 py-3 min-h-[44px] text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-primary" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="company" class="block font-medium text-text-primary">Company / Business / Clinic</label>
            <input type="text" id="company" name="company" placeholder="e.g. Apex Dental, Royal Jewellers" class="w-full bg-surface-2 border border-border-strong rounded-md px-4 py-3 min-h-[44px] text-text-primary placeholder:text-text-disabled focus:outline-none focus:ring-2 focus:ring-brand-primary" />
          </div>
          <div class="space-y-2">
            <label for="phone" class="block font-medium text-text-primary">Phone / WhatsApp <span class="text-error">*</span></label>
            <input type="tel" id="phone" name="phone" required placeholder="+91 ... or international" class="w-full bg-surface-2 border border-border-strong rounded-md px-4 py-3 min-h-[44px] text-text-primary placeholder:text-text-disabled focus:outline-none focus:ring-2 focus:ring-brand-primary" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="service" class="block font-medium text-text-primary">What do you need? <span class="text-error">*</span></label>
            <select id="service" name="service" required class="w-full bg-surface-2 border border-border-strong rounded-md px-4 py-3 min-h-[44px] text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-primary appearance-none">
              <option value="" disabled selected>Select a service...</option>
              <option value="Website Development">Website Development</option>
              <option value="Custom Software Development">Custom Software Development</option>
              <option value="SEO">SEO (Search Engine Optimization)</option>
              <option value="Digital Marketing">Digital Marketing</option>
              <option value="Social Media Management">Social Media Management</option>
              <option value="UI/UX Design">UI/UX Design</option>
              <option value="AI & Automation">AI & Automation</option>
              <option value="Cloud Solutions">Cloud Solutions</option>
              <option value="IT Consulting">IT Consulting</option>
              <option value="Multiple / Other">Multiple / Other</option>
            </select>
          </div>

          <div class="space-y-2">
            <label for="industry" class="block font-medium text-text-primary">Industry / Segment</label>
            <select id="industry" name="industry" class="w-full bg-surface-2 border border-border-strong rounded-md px-4 py-3 min-h-[44px] text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-primary appearance-none">
              <option value="" selected>Select industry (optional)...</option>
              <option value="Healthcare & Clinics">Healthcare & Clinics</option>
              <option value="Real Estate & Property">Real Estate & Property</option>
              <option value="Jewellery & Luxury Retail">Jewellery & Luxury Retail</option>
              <option value="SME / MSME">SME / MSME</option>
              <option value="Startup / Tech">Startup / Tech</option>
              <option value="Enterprise">Enterprise</option>
              <option value="International / Global">International / Global</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="budget" class="block font-medium text-text-primary">Estimated Budget (Optional)</label>
            <select id="budget" name="budget" class="w-full bg-surface-2 border border-border-strong rounded-md px-4 py-3 min-h-[44px] text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-primary appearance-none">
              <option value="" disabled selected>Select budget range...</option>
              {BUDGET_RANGES.map((range) => (
                <option value={range}>{range}</option>
              ))}
            </select>
          </div>
          <div class="space-y-2">
            <label for="timeline" class="block font-medium text-text-primary">Timeline (Optional)</label>
            <select id="timeline" name="timeline" class="w-full bg-surface-2 border border-border-strong rounded-md px-4 py-3 min-h-[44px] text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-primary appearance-none">
              <option value="" disabled selected>Select timeline...</option>
              <option value="Immediate / ASAP">Immediate / ASAP</option>
              <option value="Within 1 month">Within 1 month</option>
              <option value="1–3 months">1–3 months</option>
              <option value="Flexible">Flexible</option>
            </select>
          </div>
        </div>

        <div class="space-y-2">
          <label for="details" class="block font-medium text-text-primary">Project Details <span class="text-error">*</span></label>
          <textarea id="details" name="details" required rows="4" placeholder="Tell us about your requirements, existing site/app, or key objectives..." class="w-full bg-surface-2 border border-border-strong rounded-md px-4 py-3 min-h-[44px] text-text-primary placeholder:text-text-disabled focus:outline-none focus:ring-2 focus:ring-brand-primary"></textarea>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-4">
          <button
            type="submit"
            id="submit-btn"
            class="w-full sm:w-auto bg-button-fill text-button-text px-8 py-4 min-h-[44px] rounded-md font-bold hover:bg-button-hover transition-colors shadow-sm flex items-center justify-center gap-2"
          >
            <span>{isConnected ? "Send Inquiry" : "Send Inquiry via WhatsApp"}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 fill-current" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
          </button>
          <span class="text-xs text-text-muted">Contact SKYON directly</span>
        </div>
      </form>
    </div>

    <div class="text-center pt-8 border-t border-hairline">
      <p class="text-text-primary font-medium mb-4">Prefer direct communication?</p>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4 sm:gap-8">
        <a href={`mailto:${SITE.email}`} class="flex items-center gap-2 text-brand-primary hover:text-brand-hover font-medium min-h-[44px]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          {SITE.email}
        </a>
        <a href={SITE.whatsappUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-whatsapp hover:opacity-80 transition-opacity font-medium min-h-[44px]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 fill-current" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          {SITE.phone}
        </a>
      </div>
    </div>
  </article>

  <script define:vars={{ whatsappUrl: SITE.whatsappUrl }}>
    const form = document.getElementById('contact-form');
    const successMsg = document.getElementById('form-success');
    const errorMsg = document.getElementById('form-error');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const actionUrl = form.getAttribute('action')?.trim();
        const hasEndpoint = Boolean(actionUrl);

        const formData = new FormData(form);
        const name = formData.get('name') || '';
        const email = formData.get('email') || '';
        const phone = formData.get('phone') || '';
        const company = formData.get('company') || '';
        const service = formData.get('service') || '';
        const industry = formData.get('industry') || '';
        const budget = formData.get('budget') || '';
        const timeline = formData.get('timeline') || '';
        const details = formData.get('details') || '';

        if (!hasEndpoint) {
          // Format WhatsApp message
          let text = `*New Project Inquiry for SKYON IT SOLUTIONS*\n\n`;
          text += `*Name:* ${name}\n`;
          text += `*Email:* ${email}\n`;
          text += `*Phone:* ${phone}\n`;
          if (company) text += `*Company/Clinic:* ${company}\n`;
          if (industry) text += `*Industry:* ${industry}\n`;
          text += `*Service:* ${service}\n`;
          if (budget) text += `*Budget:* ${budget}\n`;
          if (timeline) text += `*Timeline:* ${timeline}\n`;
          text += `\n*Details:* ${details}\n`;

          const whatsappLink = new URL(whatsappUrl);
          whatsappLink.searchParams.set('text', text);
          window.open(whatsappLink.toString(), '_blank', 'noopener,noreferrer');
          return;
        }

        const submitButton = form.querySelector('button[type="submit"]');
        const originalContent = submitButton.innerHTML;
        submitButton.disabled = true;
        submitButton.textContent = 'Sending...';

        if (successMsg) successMsg.classList.add('hidden');
        if (errorMsg) errorMsg.classList.add('hidden');

        try {
          const response = await fetch(actionUrl, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            form.reset();
            if (successMsg) successMsg.classList.remove('hidden');
          } else {
            if (errorMsg) errorMsg.classList.remove('hidden');
          }
        } catch (error) {
          if (errorMsg) errorMsg.classList.remove('hidden');
        } finally {
          submitButton.disabled = false;
          submitButton.innerHTML = originalContent;
        }
      });
    }
  </script>
</Layout>
