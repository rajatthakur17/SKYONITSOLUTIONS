---
import Layout from '../../layouts/Layout.astro';
import { INSIGHTS } from '../../data/insights';

const title = 'Insights | SKYON IT SOLUTIONS';
const description = 'Practical guides to websites, custom software, and responsible AI and automation planning.';
---

<Layout title={title} description={description}>
  <section class="backdrop-10-insights px-4 pt-28 pb-12 md:px-8 md:pt-36 md:pb-16">
    <div class="mx-auto max-w-[72rem]">
      <p class="mb-3 text-sm font-bold uppercase text-brand-primary">Insights</p>
      <h1 class="max-w-[48rem] text-4xl font-extrabold leading-tight text-text-primary md:text-5xl">Practical thinking for digital projects.</h1>
      <p class="mt-5 max-w-[42rem] text-lg leading-relaxed text-text-body">Guides to planning websites, software, and automation around real business needs.</p>
    </div>
  </section>

  <section class="backdrop-10-insights border-y border-hairline px-4 py-12 md:px-8 md:py-16">
    <div class="mx-auto grid max-w-[72rem] gap-5 md:grid-cols-2 lg:grid-cols-3">
      {INSIGHTS.map((article, index) => (
        <article class="flex flex-col border-t-2 border-brand-primary px-1 py-5">
          <p class="text-xs font-bold uppercase text-brand-primary">{article.category} <span class="ml-2 text-text-muted">0{index + 1}</span></p>
          <h2 class="mt-4 text-xl font-bold leading-snug text-text-primary">{article.title}</h2>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-text-body">{article.summary}</p>
          <a href={`/insights/${article.slug}`} class="mt-6 inline-flex min-h-11 items-center gap-2 font-bold text-brand-primary hover:text-brand-hover">
            Read guide <span aria-hidden="true">&rarr;</span>
          </a>
        </article>
      ))}
    </div>
  </section>
</Layout>