---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../config/site';

const title = "Search Engine Optimization Services | SKYON IT SOLUTIONS";
const description = "We provide technical SEO, on-page SEO, local SEO, and content strategy services to structure your digital presence for search engines.";
const currentUrl = `${SITE.url}/services/seo`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": `${SITE.url}/#services` },
    { "@type": "ListItem", "position": 3, "name": "Search Engine Optimization", "item": currentUrl }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Search Engine Optimization",
  "provider": { "@type": "Organization", "name": "SKYON IT SOLUTIONS", "url": SITE.url },
  "url": currentUrl,
  "description": description
};
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>
  
  <article class="pt-32 pb-24 px-4 md:px-8 max-w-[48rem] mx-auto">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-text-disabled">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-brand-hover transition-colors">Home</a></li>
        <li><span aria-hidden="true">/</span></li>
        <li><a href="/#services" class="hover:text-brand-hover transition-colors">Services</a></li>
        <li><span aria-hidden="true">/</span></li>
        <li class="text-text-primary" aria-current="page">SEO</li>
      </ol>
    </nav>

    <h1 class="text-4xl md:text-5xl font-extrabold text-text-primary tracking-tight mb-8">Search Engine Optimization</h1>
    
    <div class="text-text-body space-y-6 text-lg leading-relaxed">
      <p>
        Search Engine Optimization (SEO) involves structuring your website and content so that it can be crawled, understood, and indexed by search engines. Our approach focuses on technical accuracy, relevant content, and proper page structure.
      </p>

      <h2 class="text-2xl font-bold text-text-primary mt-12 mb-4">Understanding Search Visibility</h2>
      <p>
        Search visibility refers to how prominently a digital property appears in organic search engine results for relevant queries. Unlike paid advertising, where visibility is purchased directly, organic search visibility is earned over time. Achieving visibility requires aligning a website's technical foundation and written content with the signals that search engine algorithms use to evaluate relevance and authority. 
      </p>
      <p>
        Search engines utilize complex, constantly evolving algorithms to index and rank web pages. While the exact mathematics of these algorithms are proprietary, their fundamental goal remains consistent: to provide users with the most relevant and technically sound answers to their queries. Therefore, SEO is an ongoing practice of removing technical barriers to crawling and providing clear, structured answers to user intent.
      </p>
      
      <h2 class="text-2xl font-bold text-text-primary mt-12 mb-4">Core SEO Focus Areas</h2>
      <p>
        Our SEO work covers four areas:
      </p>
      <ul class="list-disc pl-6 space-y-2">
        <li><strong>Technical SEO:</strong> We work on the technical foundation of your site so it supports search visibility.</li>
        <li><strong>On-Page SEO:</strong> We work on how individual pages are written and structured so they match what people search for.</li>
        <li><strong>Local SEO:</strong> We optimize your digital footprint for localized search queries.</li>
        <li><strong>Content Strategy:</strong> We plan and structure content to answer the questions your audience is searching for.</li>
      </ul>

      <p>
        These elements work together to form a cohesive digital strategy. Technical SEO provides the infrastructure, ensuring that a search engine bot can successfully navigate the site without encountering server errors or broken links. On-page SEO provides the explicit contextual signals—such as page titles and descriptive URLs—that summarize a page's topic. Finally, content strategy delivers the actual information that users are seeking, addressing specific questions and concepts in detail.
      </p>

      <h2 class="text-2xl font-bold text-text-primary mt-12 mb-4">Our Process</h2>
      <p>
        Our SEO projects follow a consistent methodology:
      </p>
      <ul class="list-disc pl-6 space-y-2">
        <li><strong>Understand:</strong> We learn about the business and goals.</li>
        <li><strong>Strategize:</strong> We plan the approach.</li>
        <li><strong>Build:</strong> We do the work.</li>
        <li><strong>Launch:</strong> We launch the updates.</li>
        <li><strong>Grow:</strong> We review and improve.</li>
      </ul>

      <h2 class="text-2xl font-bold text-text-primary mt-12 mb-4">Frequently Asked Questions</h2>
      <details class="group border-b border-hairline py-4">
        <summary class="font-bold cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary text-text-primary">What does technical SEO involve?</summary>
        <p class="mt-4 text-base">Technical SEO involves optimizing the underlying code and server configuration of a website so search engines can navigate it effectively.</p>
      </details>
      <details class="group border-b border-hairline py-4">
        <summary class="font-bold cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary text-text-primary">How does on-page SEO differ from content strategy?</summary>
        <p class="mt-4 text-base">Content strategy is the high-level planning of what topics to cover and what information to provide based on search intent. On-page SEO is the technical execution of that content on a specific web page, ensuring that title tags, heading structures, and internal links clearly communicate the topic to search engines.</p>
      </details>
      <details class="group border-b border-hairline py-4">
        <summary class="font-bold cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary text-text-primary">What makes local SEO unique?</summary>
        <p class="mt-4 text-base">Local SEO focuses on optimizing a digital presence for location-based search queries to signal geographic relevance.</p>
      </details>
    </div>

    <div class="mt-16 pt-8 border-t border-hairline">
      <h3 class="text-xl font-bold text-text-primary mb-4">Ready to discuss your project?</h3>
      <a href="/contact" class="inline-block bg-button-fill text-[#0A1A05] px-8 py-3 rounded-full font-semibold hover:bg-button-hover transition-colors shadow-sm">
        Contact Us
      </a>
    </div>

    <div class="mt-16 pt-8 border-t border-hairline flex flex-wrap gap-4 text-sm font-medium">
      <span class="text-text-disabled">Other Services:</span>
      <a href="/services/website-development" class="text-brand-primary hover:text-brand-hover">Website Development</a>
      <a href="/services/digital-marketing" class="text-brand-primary hover:text-brand-hover">Digital Marketing</a>
      <a href="/services/social-media" class="text-brand-primary hover:text-brand-hover">Social Media Management</a>
    </div>
  </article>
</Layout>
