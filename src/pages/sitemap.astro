  </main>

  <!-- Client-side Fast Search Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('sitemap-search');
      const clearBtn = document.getElementById('clear-search-btn');
      const resetBtn = document.getElementById('reset-search-btn');
      const emptyState = document.getElementById('search-empty-state');
      const feedback = document.getElementById('search-feedback');
      const cards = document.querySelectorAll('.sitemap-card');
      const groups = document.querySelectorAll('.sitemap-group');

      if (!searchInput) return;

      const performFilter = (query) => {
        const q = query.trim().toLowerCase();

        if (q.length > 0) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }

        let visibleCardsCount = 0;

        cards.forEach((card) => {
          const text = card.textContent.toLowerCase();
          const href = card.querySelector('a')?.getAttribute('href')?.toLowerCase() || '';
          const match = text.includes(q) || href.includes(q);

          if (match) {
            card.classList.remove('hidden');
            visibleCardsCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Hide empty groups
        groups.forEach((group) => {
          const visibleInGroup = group.querySelectorAll('.sitemap-card:not(.hidden)').length;
          if (visibleInGroup === 0 && q.length > 0) {
            group.classList.add('hidden');
          } else {
            group.classList.remove('hidden');
          }
        });

        // Handle empty state
        if (visibleCardsCount === 0 && q.length > 0) {
          emptyState?.classList.remove('hidden');
          if (feedback) {
            feedback.classList.remove('hidden');
            feedback.textContent = `No pages match "${query}"`;
          }
        } else {
          emptyState?.classList.add('hidden');
          if (feedback) {
            if (q.length > 0) {
              feedback.classList.remove('hidden');
              feedback.textContent = `Showing ${visibleCardsCount} matching page${visibleCardsCount === 1 ? '' : 's'}`;
            } else {
              feedback.classList.add('hidden');
              feedback.textContent = '';
            }
          }
        }
      };

      searchInput.addEventListener('input', (e) => {
        performFilter(e.target.value);
      });

      clearBtn?.addEventListener('click', () => {
        searchInput.value = '';
        performFilter('');
        searchInput.focus();
      });

      resetBtn?.addEventListener('click', () => {
        searchInput.value = '';
        performFilter('');
        searchInput.focus();
      });
    });
  </script>
</Layout>
