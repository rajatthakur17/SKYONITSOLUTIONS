---
import Layout from '../layouts/Layout.astro';

const title = "Terms of Service | SKYON IT SOLUTIONS";
const description = "Terms of Service for SKYON IT SOLUTIONS.";
---

<Layout title={title} description={description}>
  <article class="pt-32 pb-24 px-4 md:px-8 max-w-[48rem] mx-auto text-text-body">
    <div class="mb-8 p-4 bg-brand-primary/10 border border-brand-primary text-brand-primary rounded-md font-medium text-center">
      Draft pending legal review
    </div>

    <h1 class="text-4xl md:text-5xl font-extrabold text-text-primary tracking-tight mb-8">Terms of Service</h1>
    
    <div class="space-y-6 text-lg leading-relaxed">
      <p>
        The content provided on this website is for general informational purposes regarding our website development, SEO, digital marketing, and social media management services.
      </p>
      
      <p>
        Submitting a project inquiry through our contact form does not create a binding contract for services. Projects are agreed separately in writing through a dedicated proposal or contract tailored to your specific requirements.
      </p>
    </div>
  </article>
</Layout>
