---
import { Image } from 'astro:assets';
import workspaceBackground from '../../backgoundim/Neon Blue Digital Workspace Portfolio.png';
import Layout from '../layouts/Layout.astro';
import InternalProduct from '../components/sections/InternalProduct.astro';

const title = 'Our Work & Case Proof | SKYON IT SOLUTIONS';
const description = 'Explore real-world engineering case studies, verified client web platforms, and internal digital products built by SKYON IT SOLUTIONS.';
---

<Layout title={title} description={description}>
  <section class="work-hero backdrop-06-work border-b border-hairline px-4 pt-28 pb-16 md:px-8 md:pt-36 md:pb-20">
    <Image
      src={workspaceBackground}
      alt=""
      aria-hidden="true"
      class="work-hero-background"
      loading="eager"
    />
    <div class="relative z-1 mx-auto max-w-[72rem]">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-6 text-xs text-text-muted">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-brand-hover transition-colors">Home</a></li>
          <li><span aria-hidden="true">/</span></li>
          <li class="text-text-primary font-medium" aria-current="page">Our Work</li>
        </ol>
      </nav>

      <p class="mb-3 text-xs md:text-sm font-bold uppercase tracking-wider text-brand-primary">
        Portfolio &amp; Engineering Case Proof
      </p>
      <h1 class="max-w-[48rem] text-3xl sm:text-4xl md:text-5xl font-extrabold leading-tight text-text-primary tracking-tight">
        Engineered web platforms, custom applications, and digital products.
      </h1>
      <p class="mt-5 max-w-[42rem] text-base md:text-lg leading-relaxed text-text-body">
        Explore verified commercial client delivery and internal digital utilities built by SKYON IT SOLUTIONS. Every system is engineered for sub-second performance, strict data privacy, and measurable business ROI.
      </p>
    </div>
  </section>
  <InternalProduct isPage={true} />
</Layout>

<style>
  .work-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .work-hero::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--overlay-work);
    content: '';
    pointer-events: none;
  }

  .work-hero-background {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    opacity: 0.85;
    pointer-events: none;
  }

  @media (max-width: 48rem) {
    .work-hero-background {
      object-position: center;
    }
  }
</style>