---
import { Image } from 'astro:assets';
import workspaceBackground from '../../backgoundim/Neon Blue Digital Workspace Portfolio.png';
import Layout from '../layouts/Layout.astro';
import InternalProduct from '../components/sections/InternalProduct.astro';

const title = 'Selected Work | SKYON IT SOLUTIONS';
const description = 'View SKYON IT SOLUTIONS approved project proof and internal digital products.';
---

<Layout title={title} description={description}>
  <section class="work-hero backdrop-06-work border-b border-hairline px-4 pt-28 pb-16 md:px-8 md:pt-36 md:pb-20">
    <Image
      src={workspaceBackground}
      alt=""
      aria-hidden="true"
      class="work-hero-background"
      loading="eager"
    />
    <div class="relative z-1 mx-auto max-w-[72rem]">
      <p class="mb-3 text-sm font-bold uppercase text-brand-primary">Selected work</p>
      <h1 class="max-w-[48rem] text-4xl font-extrabold leading-tight text-text-primary md:text-5xl">Projects and products built by SKYON.</h1>
      <p class="mt-5 max-w-[42rem] text-lg leading-relaxed text-text-body">Explore an approved client project and an internal product. Client results and project details are included only when confirmed for publication.</p>
    </div>
  </section>
  <InternalProduct isPage={true} />
</Layout>

<style>
  .work-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .work-hero::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(7, 20, 31, 0.95) 0%,
      rgba(13, 29, 45, 0.90) 55%,
      rgba(7, 20, 31, 0.82) 100%
    );
    content: '';
    pointer-events: none;
  }

  .work-hero-background {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    opacity: 0.85;
    pointer-events: none;
  }

  @media (max-width: 48rem) {
    .work-hero-background {
      object-position: center;
    }
  }
</style>